@inject Microsoft.AspNetCore.Http.IHttpContextAccessor HttpContextAccessor
@{
    var username = HttpContextAccessor.HttpContext.Session.GetString("Username");
    var fullname = HttpContextAccessor.HttpContext.Session.GetString("FullName");

    ViewData["username"] = username;
    ViewData["fullname"] = fullname;
}
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8" />
    <title>@ViewData["Title"] - MyGarage</title>
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <!-- Fonts & Styles -->
    <link href="https://fonts.googleapis.com/css2?family=Cairo:wght@200;300;400;600;900&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/header.css" asp-append-version="true" />

    <link rel="stylesheet" href="~/layout1/css/bootstrap.min.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/layout1/css/font-awesome.min.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/layout1/css/style.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/news-section.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/services-section.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/home-sections.css" asp-append-version="true" />

    <style>
        html, body {
            margin: 0;
            padding: 0;
            height: 100%;
            overflow-x: hidden;
        }

        .hero-section {
            position: relative;
            height: 100vh;
            width: 100%;
            overflow: hidden;
        }

        .hero-video {
            position: absolute;
            top: 0;
            left: 0;
            min-width: 100%;
            min-height: 100%;
            object-fit: cover;
            z-index: -2;
        }

        .hero-overlay {
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background: rgba(0, 0, 0, 0.4);
            z-index: -1;
        }

        .hero-section header {
            position: absolute;
            top: 0;
            width: 100%;
            z-index: 10;
            background: transparent !important;
        }

        main {
            position: relative;
            z-index: 1;
            background: #fff;
        }

        .scroll-indicator {
            position: absolute;
            bottom: 20px;
            left: 50%;
            transform: translateX(-50%);
            text-align: center;
            color: #fff;
        }

            .scroll-indicator a {
                display: block;
                font-size: 2rem;
                color: white;
                animation: bounce 2s infinite;
            }

        @@keyframes bounce {
            0%, 100%

        {
            transform: translateY(0);
        }

        50% {
            transform: translateY(10px);
        }

        }
    </style>
</head>
<body>

    <!-- PHẦN HERO bao gồm video và header -->
    <section class="hero-section">
        <video autoplay muted loop playsinline class="hero-video">
            <source src="~/videos/hero.mp4" type="video/mp4" />
        </video>
        <div class="hero-overlay"></div>

        <!-- Nút Scroll -->
        <div class="scroll-indicator">
            <span>SCROLL</span>
            <a href="#main-content"><i class="fa fa-angle-down"></i></a>
        </div>

        <!-- Header nổi trên video -->
        @await Html.PartialAsync("_Header")
    </section>

    <!-- Nội dung trang chủ -->
    <main id="main-content">
        @RenderBody()
    </main>

    <!-- Footer -->
    @await Html.PartialAsync("_Footer")

    <!-- Scripts (Bootstrap JS bundle phải nằm cuối cùng để dropdown hoạt động) -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    >

    @await Html.PartialAsync("_Scripts")
    @RenderSection("Scripts", required: false)
</body>
</html>
