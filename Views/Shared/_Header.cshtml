@inject Microsoft.AspNetCore.Http.IHttpContextAccessor HttpContextAccessor

@{
    var username = HttpContextAccessor.HttpContext.Session.GetString("Username") ?? "";
    var userid = HttpContextAccessor.HttpContext.Session.GetString("UserID") ?? "";
    var fullname = HttpContextAccessor.HttpContext.Session.GetString("FullName") ?? "";
    var role = HttpContextAccessor.HttpContext.Session.GetString("Role") ?? "";
    var currentController = ViewContext.RouteData.Values["controller"]?.ToString();
    var currentAction = ViewContext.RouteData.Values["action"]?.ToString();
    var isHomeIndex = (currentController == "Home" && (currentAction == null || currentAction == "Index"));
}
<link rel="stylesheet" href="~/css/_Header.cshtml.css" asp-append-version="true" />
<link href="https://fonts.googleapis.com/css?family=Roboto:400,500,700&display=swap" rel="stylesheet">

<header class="header position-absolute start-0 w-100 z-3" style="top: 0px !important; background: transparent;">
    <!-- Dòng trên cùng chứa thông tin đăng nhập nằm bên phải -->
    <div class="container-fluid d-flex justify-content-end align-items-center px-4" style="height: 40px;">
        <div class="d-flex align-items-center gap-3">
            @if (string.IsNullOrEmpty(username))
            {
                <!-- Dropdown khi chưa đăng nhập -->
                <div class="dropdown">
                    <a class="btn account-dropdown-toggle btn-sm dropdown-toggle" href="#" role="button" id="guestDropdown"
                       data-bs-toggle="dropdown" aria-expanded="false">
                        Tài khoản
                    </a>
                    <ul class="dropdown-menu account-dropdown" aria-labelledby="guestDropdown">
                        <li>
                            <a class="dropdown-item" href="@Url.Action("Login", "AccountLogin")">
                                 Đăng nhập
                            </a>
                        </li>
                        <li>
                            <a class="dropdown-item" href="@Url.Action("Register", "AccountRegister")">
                                 Đăng ký
                            </a>
                        </li>
                    </ul>
                </div>
            }
            else
            {
                <!-- Dropdown khi đã đăng nhập -->
                <div class="dropdown">
                    <a class="btn account-dropdown-toggle btn-sm dropdown-toggle" href="#" role="button" id="userDropdown"
                       data-bs-toggle="dropdown" aria-expanded="false">
                        Xin chào, @fullname
                    </a>
                    <ul class="dropdown-menu account-dropdown" aria-labelledby="userDropdown">
                        <li><a class="dropdown-item" href="/Account/Profile">Thông tin cá nhân</a></li>

                        @if (role == "User")
                        {
                            <li><a class="dropdown-item" href="/Account/Favorites">Sản phẩm ưu thích</a></li>
                            <li><a class="dropdown-item" href="/Cart/Index">Giỏ hàng</a></li>
                            <li><a class="dropdown-item" href="/Appointment/History">Lịch sử đặt lịch</a></li>
                            <li><a class="dropdown-item" href="/Appointment/AllAppointments">Tất cả lịch hẹn</a></li>
                        }
                        else if (role == "Technician")
                        {
                            <li><a class="dropdown-item" href="/Technician/Dashboard">Phân công công việc</a></li>
                        }

                        <li><a class="dropdown-item" href="/Account/ChangePassword">Đổi mật khẩu</a></li>
                        <li><a class="dropdown-item" href="/Account/Logout">Đăng xuất</a></li>
                    </ul>
                </div>
            }
        </div>
    </div>

    <!-- Dòng menu chính giữa -->
    <div class="container d-flex justify-content-center align-items-end pt-1 pb-2 flex-wrap" style="gap: 50px;">
        <!-- Menu trái -->
        <a href="@Url.Action("Index", "Services")" class="text-white text-uppercase">Dịch vụ</a>
        <a href="@Url.Action("Index", "Products")" class="text-white text-uppercase">Sản phẩm</a>
        <a href="@Url.Action("Favorites", "Account")" class="text-white text-uppercase">Yêu thích</a>

        <!-- Logo ở giữa -->
        <a href="@Url.Action("Index", "Home")">
            @if (isHomeIndex)
            {
                <div style="margin-bottom: 20px; display: flex; flex-direction: column; align-items: center;">
                    <img src="~/layout1/img/logo3-removebg-preview.png" alt="Logo" style="height: 90px;" />
                </div>
            }
            else
            {
                <div style="margin-bottom: 20px; display: flex; flex-direction: column; align-items: center;">
                    <span style="font-size: 56px; font-weight: bold; color: #c3a25a; letter-spacing: 2px; line-height: 1; font-family: 'Arial Black', Arial, sans-serif;">MY</span>
                    <span style="font-size: 28px; font-weight: 500; color: #c3a25a; letter-spacing: 12px; margin-top: -6px; font-family: 'Arial', sans-serif;">GARAGE</span>
                </div>
            }
        </a>

        <!-- Menu phải -->
        <a href="@Url.Action("CreateMulti", "Appointment")" class="text-white text-uppercase" style="text-decoration: none;">
            Đặt lịch
        </a>
        <a href="@Url.Action("Index", "Garages")" class="text-white text-uppercase">Garage</a>
        <a href="@Url.Action("Contact", "Home")" class="text-white text-uppercase">Liên hệ</a>
    </div>
</header>

<style>
    .header, .header * {
        font-family: 'Roboto', Arial, sans-serif !important;
    }
    
    /* Hiệu ứng gạch chân cho các menu items */
    .header .container a {
        position: relative !important;
        transition: all 0.3s ease !important;
    }
    
    .header .container a::after {
        content: '' !important;
        position: absolute !important;
        width: 0 !important;
        height: 2px !important;
        bottom: -5px !important;
        left: 50% !important;
        background-color: #111 !important;
        transition: all 0.3s ease !important;
        transform: translateX(-50%) !important;
    }
    
    .header .container a:hover::after {
        width: 100% !important;
    }
    
    /* Hiệu ứng cho trang không phải home */
    .header a,
    .header .dropdown-toggle,
    .header .dropdown-item {
        color: #111 !important;
    }

    /* Nếu là trang Home thì tất cả chữ trong header đều màu trắng, riêng dropdown có border trắng, nền trong suốt */
    @if (isHomeIndex) {
    @: .header a, .header .dropdown-toggle, .header .dropdown-item { color: #fff !important; }
    @: .header .container a::after { background-color: #fff !important; }
    @: .header .dropdown-menu { background: transparent !important; border: 1px solid #fff !important; }
    @: .header .dropdown-item { color: #fff !important; }
    @: .header .dropdown-item:hover, .header .dropdown-item:focus { background: rgba(255,255,255,0.1) !important; color: #fff !important; }
    }
    /* Nếu là trang Home thì dropdown-toggle chữ trắng, border trắng, nền trong suốt; dropdown-menu nền đen mờ, border trắng, shadow; dropdown-item chữ trắng, hover nền sáng nhẹ */
    @if (isHomeIndex) {
    @: .header .dropdown-toggle { color: #fff !important; border: 1px solid #fff !important; background: transparent !important; }
    @: .header .dropdown-menu { background: rgba(0,0,0,0) !important; border: 1px solid #fff !important; box-shadow: 0 4px 16px rgba(0,0,0,0.3) !important; }
    @: .header .dropdown-menu .dropdown-item { color: #fff !important; }
    @: .header .dropdown-menu .dropdown-item:hover, .header .dropdown-menu .dropdown-item:focus { background: rgba(255,255,255,0.15) !important; color: #fff !important; }
    }
</style>
