@model AppointmentHistoryViewModel

@{
    ViewData["Title"] = "Lịch hẹn của bạn";
}

<h2>Lịch hẹn được giao</h2>

@if (!Model.Appointments.Any())
{
    <p>Hiện tại bạn không có lịch hẹn nào.</p>
}
else
{
    @foreach (var appt in Model.Appointments)
    {
        <div class="card mb-3 p-3 shadow-sm">
            <h5>Ngày hẹn: @(appt.AppointmentTime?.ToString("dd/MM/yyyy HH:mm") ?? "Chưa xác định")</h5>
            <p><strong>Khách hàng:</strong> @appt.User?.FullName</p>
            <p><strong>Số điện thoại:</strong> @appt.User?.Phone</p>
            <p><strong>Garage:</strong> @appt.Garage?.Address</p>
            <p><strong>Trạng thái:</strong> @appt.Status</p>
            <p><strong>Ghi chú:</strong> @(string.IsNullOrWhiteSpace(appt.Notes) ? "(Không có)" : appt.Notes)</p>

            <h6 class="mt-3">Dịch vụ và xe:</h6>
            <ul>
                @foreach (var detail in Model.Details.Where(d => d.AppointmentId == appt.AppointmentId))
                {
                    <li>
                        <strong>Xe:</strong> @($"{detail.Vehicle?.Make} {detail.Vehicle?.Model}") (@detail.Vehicle?.LicensePlate)<br />
                        <strong>Dịch vụ:</strong> @detail.Service?.ServiceName<br />
                        <strong>Số lượng:</strong> @detail.Quantity
                    </li>
                }
            </ul>
        </div>
    }
}
