@{
    ViewBag.Title = "Technician Dashboard";
}
@{
    var username = ViewData["username"] as string ?? "";
    var fullname = ViewData["fullname"] as string ?? "";
}

<!-- Hero Section -->
<section class="dashboard-hero">
    <div class="floating-shapes">
        <div class="shape"></div>
        <div class="shape"></div>
        <div class="shape"></div>
    </div>
    <div class="container">
        <h1><i class="fa fa-user-md"></i> Chào mừng đến trang quản lý <span class="gradient-text">Kỹ thuật viên</span></h1>
        <p>Quản lý lịch hẹn, công việc và dịch vụ sửa chữa một cách hiệu quả!</p>
    </div>
</section>

<div class="container dashboard-section">
    <div class="row justify-content-center g-4">
        <div class="col-12 col-md-6 col-lg-3">
            <div class="dashboard-card">
                <div class="dashboard-card-icon">
                    <i class="fa fa-calendar-check-o"></i>
                </div>
                <h5>Quản lý Lịch hẹn</h5>
                <p>Xem tất cả lịch hẹn, nhận việc và cập nhật trạng thái công việc.</p>
                <a href="@Url.Action("Tasks", "Technician")" class="btn btn-primary btn-action">Quản lý Lịch hẹn</a>
            </div>
        </div>
        <div class="col-12 col-md-6 col-lg-3">
            <div class="dashboard-card">
                <div class="dashboard-card-icon">
                    <i class="fa fa-tasks"></i>
                </div>
                <h5>Công việc đang làm</h5>
                <p>Theo dõi các lịch hẹn đang thực hiện và cập nhật tiến độ.</p>
                <a href="@Url.Action("Tasks", "Technician", new { tab = "mine" })" class="btn btn-success btn-action">Xem công việc</a>
            </div>
        </div>
        <div class="col-12 col-md-6 col-lg-3">
            <div class="dashboard-card">
                <div class="dashboard-card-icon">
                    <i class="fa fa-history"></i>
                </div>
                <h5>Lịch sử hoàn thành</h5>
                <p>Xem lại các lịch hẹn đã hoàn thành và đánh giá từ khách hàng.</p>
                <a href="@Url.Action("Tasks", "Technician")" class="btn btn-warning btn-action">Lịch sử</a>
            </div>
        </div>
        <div class="col-12 col-md-6 col-lg-3">
            <div class="dashboard-card">
                <div class="dashboard-card-icon">
                    <i class="fa fa-cogs"></i>
                </div>
                <h5>Dịch vụ & Sản phẩm</h5>
                <p>Xem danh sách dịch vụ và sản phẩm có sẵn tại garage.</p>
                <a href="@Url.Action("Index", "Service")" class="btn btn-info btn-action">Dịch vụ</a>
            </div>
        </div>
    </div>

    <!-- Thống kê nhanh -->
    <div class="row mt-5">
        <div class="col-12">
            <h4 class="dashboard-title">
                <i class="fa fa-chart-bar"></i> Thống kê công việc
            </h4>
        </div>
    </div>
    <div class="row g-4">
        <div class="col-md-3">
            <div class="stats-card stats-pending">
                <div class="stats-icon">
                    <i class="fa fa-clock-o"></i>
                </div>
                <div class="stats-content">
                    <h5>Đang chờ</h5>
                    <h3>@(ViewData["PendingCount"] ?? 0)</h3>
                    <small>Lịch hẹn chờ xử lý</small>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="stats-card stats-progress">
                <div class="stats-icon">
                    <i class="fa fa-spinner"></i>
                </div>
                <div class="stats-content">
                    <h5>Đang làm</h5>
                    <h3>@(ViewData["InProgressCount"] ?? 0)</h3>
                    <small>Công việc đang thực hiện</small>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="stats-card stats-completed">
                <div class="stats-icon">
                    <i class="fa fa-check-circle"></i>
                </div>
                <div class="stats-content">
                    <h5>Hoàn thành</h5>
                    <h3>@(ViewData["CompletedCount"] ?? 0)</h3>
                    <small>Lịch hẹn đã hoàn thành</small>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="stats-card stats-today">
                <div class="stats-icon">
                    <i class="fa fa-calendar"></i>
                </div>
                <div class="stats-content">
                    <h5>Hôm nay</h5>
                    <h3>@(ViewData["TodayCount"] ?? 0)</h3>
                    <small>Lịch hẹn hôm nay</small>
                </div>
            </div>
        </div>
    </div>

    <!-- Lịch hẹn gần đây -->
    <div class="row mt-5">
        <div class="col-12">
            <div class="dashboard-table-card">
                <div class="dashboard-table-header">
                    <h5>
                        <i class="fa fa-calendar-o"></i> Lịch hẹn gần đây
                    </h5>
                </div>
                <div class="dashboard-table-body">
                    @{
                        var recentAppointments = ViewData["RecentAppointments"] as List<test_2.Models.Appointment>;
                    }

                    @if (recentAppointments != null && recentAppointments.Any())
                    {
                        <div class="table-responsive">
                            <table class="table table-hover">
                                <thead>
                                    <tr>
                                        <th>Mã lịch hẹn</th>
                                        <th>Khách hàng</th>
                                        <th>Dịch vụ</th>
                                        <th>Thời gian</th>
                                        <th>Trạng thái</th>
                                        <th>Kỹ thuật viên</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var appointment in recentAppointments)
                                    {
                                        <tr>
                                            <td>
                                                <span class="appointment-id">#@appointment.AppointmentId</span>
                                            </td>
                                            <td>
                                                <div>
                                                    <strong>@appointment.User?.FullName</strong>
                                                    <br>
                                                    <small class="text-muted">@appointment.User?.Phone</small>
                                                </div>
                                            </td>
                                            <td>
                                                @if (appointment.AppointmentVehicleDetails != null && appointment.AppointmentVehicleDetails.Any())
                                                {
                                                    <div>
                                                        @foreach (var detail in appointment.AppointmentVehicleDetails.Take(2))
                                                        {
                                                            <span class="service-badge">
                                                                @detail.Service?.ServiceName
                                                            </span>
                                                        }
                                                        @if (appointment.AppointmentVehicleDetails.Count > 2)
                                                        {
                                                            <span class="service-badge">+@(appointment.AppointmentVehicleDetails.Count - 2) more</span>
                                                        }
                                                    </div>
                                                }
                                            </td>
                                            <td>
                                                <div>
                                                    <strong>@(appointment.AppointmentTime?.ToString("dd/MM/yyyy") ?? "N/A")</strong>
                                                    <br>
                                                    <small class="text-muted">@(appointment.AppointmentTime?.ToString("HH:mm") ?? "N/A")</small>
                                                </div>
                                            </td>
                                            <td>
                                                @{
                                                    var statusClass = appointment.Status switch
                                                    {
                                                        "Pending" => "status-pending",
                                                        "WaitingForAccept" => "status-waiting",
                                                        "In_Progress" => "status-progress",
                                                        "Completed" => "status-completed",
                                                        "Cancelled" => "status-cancelled",
                                                        _ => "status-other"
                                                    };
                                                }
                                                <span class="status-badge @statusClass">@appointment.Status</span>
                                            </td>
                                            <td>
                                                @if (appointment.AppointmentVehicleDetails != null && appointment.AppointmentVehicleDetails.Any())
                                                {
                                                    var technicians = appointment.AppointmentVehicleDetails
                                                    .Select(d => d.Technician?.FullName)
                                                    .Where(name => !string.IsNullOrEmpty(name))
                                                    .Distinct()
                                                    .ToList();

                                                    if (technicians.Any())
                                                    {
                                                        <span class="technician-info">
                                                            <i class="fa fa-user"></i> @string.Join(", ", technicians)
                                                        </span>
                                                    }
                                                    else
                                                    {
                                                        <span class="technician-info empty">
                                                            <i class="fa fa-user-times"></i> Chưa phân công
                                                        </span>
                                                    }
                                                }
                                                else
                                                {
                                                    <span class="technician-info empty">
                                                        <i class="fa fa-user-times"></i> Chưa có dữ liệu
                                                    </span>
                                                }
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                        <div class="text-center mt-3">
                            <a href="@Url.Action("Tasks", "Technician")" class="btn btn-primary btn-action">
                                <i class="fa fa-list me-1"></i> Xem tất cả lịch hẹn
                            </a>
                        </div>
                    }
                    else
                    {
                        <div class="empty-state">
                            <i class="fa fa-calendar-times"></i>
                            <h5>Chưa có lịch hẹn nào</h5>
                            <p>Hệ thống sẽ hiển thị các lịch hẹn gần đây tại đây</p>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>

    <!-- Công việc chờ nhận -->
    <div class="row mt-5">
        <div class="col-12">
            <div class="dashboard-table-card">
                <div class="dashboard-table-header">
                    <h5>
                        <i class="fa fa-hand-paper-o"></i> Công việc chờ nhận
                    </h5>
                </div>
                <div class="dashboard-table-body">
                    @{
                        var availableAppointments = ViewData["AvailableAppointments"] as List<test_2.Models.Appointment>;
                    }
                    @if (availableAppointments != null && availableAppointments.Any())
                    {
                        <div class="table-responsive">
                            <table class="table table-hover">
                                <thead>
                                    <tr>
                                        <th>Mã lịch hẹn</th>
                                        <th>Khách hàng</th>
                                        <th>Dịch vụ</th>
                                        <th>Thời gian</th>
                                        <th>Trạng thái</th>
                                        <th>Nhận việc</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var appointment in availableAppointments)
                                    {
                                        <tr>
                                            <td>
                                                <span class="appointment-id">#@appointment.AppointmentId</span>
                                            </td>
                                            <td>
                                                <div>
                                                    <strong>@appointment.User?.FullName</strong>
                                                    <br>
                                                    <small class="text-muted">@appointment.User?.Phone</small>
                                                </div>
                                            </td>
                                            <td>
                                                @if (appointment.AppointmentVehicleDetails != null && appointment.AppointmentVehicleDetails.Any())
                                                {
                                                    <div>
                                                        @foreach (var detail in appointment.AppointmentVehicleDetails.Take(2))
                                                        {
                                                            <span class="service-badge">
                                                                @detail.Service?.ServiceName
                                                            </span>
                                                        }
                                                        @if (appointment.AppointmentVehicleDetails.Count > 2)
                                                        {
                                                            <span class="service-badge">+@(appointment.AppointmentVehicleDetails.Count - 2) more</span>
                                                        }
                                                    </div>
                                                }
                                            </td>
                                            <td>
                                                <div>
                                                    <strong>@(appointment.AppointmentTime?.ToString("dd/MM/yyyy") ?? "N/A")</strong>
                                                    <br>
                                                    <small class="text-muted">@(appointment.AppointmentTime?.ToString("HH:mm") ?? "N/A")</small>
                                                </div>
                                            </td>
                                            <td>
                                                <span class="status-badge status-pending">@appointment.Status</span>
                                            </td>
                                            <td>
                                                <form asp-action="AcceptJob" asp-controller="Technician" method="post" style="display:inline;">
                                                    <input type="hidden" name="amount" value="@appointment.AppointmentId" />
                                                    <input type="hidden" name="description" value="Thanh toán lịch hẹn #@appointment.AppointmentId - @appointment.User?.FullName" />
                                                    <input type="hidden" name="appointmentId" value="@appointment.AppointmentId" />
                                                    <button type="submit" class="btn btn-warning btn-sm btn-action">
                                                        <i class="fa fa-hand-pointer-o"></i> Nhận việc
                                                    </button>
                                                </form>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                    else
                    {
                        <div class="empty-state">
                            <i class="fa fa-info-circle"></i>
                            <h5>Không có công việc chờ nhận nào</h5>
                            <p>Tất cả công việc đã được phân công hoặc đang được xử lý</p>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

<!-- FontAwesome CDN -->
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/4.7.0/css/font-awesome.min.css" />

<style>
    body {
        background: #f8f9fa;
        color: #152A16;
    }
    .dashboard-hero {
        background: linear-gradient(135deg, #28a745 0%, #20c997 50%, #17a2b8 100%);
        padding: 60px 0 40px 0;
        margin-top: 80px;
        color: white;
        text-align: center;
        position: relative;
        overflow: hidden;
    }
    .floating-shapes {
        position: absolute;
        width: 100%;
        height: 100%;
        overflow: hidden;
        z-index: 1;
    }
    .shape {
        position: absolute;
        background: rgba(255,255,255,0.1);
        border-radius: 50%;
        animation: float 6s ease-in-out infinite;
    }
    .shape:nth-child(1) {
        width: 80px;
        height: 80px;
        top: 20%;
        left: 10%;
        animation-delay: 0s;
    }
    .shape:nth-child(2) {
        width: 60px;
        height: 60px;
        top: 60%;
        right: 10%;
        animation-delay: 2s;
    }
    .shape:nth-child(3) {
        width: 40px;
        height: 40px;
        top: 40%;
        left: 50%;
        animation-delay: 4s;
    }
    @@keyframes float {
        0%, 100% { transform: translateY(0px) rotate(0deg); }
        50% { transform: translateY(-20px) rotate(180deg); }
    }
    .dashboard-hero h1 {
        font-size: 2.6rem;
        font-weight: 800;
        margin-bottom: 10px;
        text-shadow: 2px 2px 4px rgba(0,0,0,0.18);
        position: relative;
        z-index: 2;
    }
    .dashboard-hero p {
        font-size: 1.15rem;
        opacity: 0.95;
        font-weight: 300;
        margin-bottom: 0;
        position: relative;
        z-index: 2;
    }
    .gradient-text {
        background: linear-gradient(135deg, #fff 0%, #e8f5e8 100%);
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
        background-clip: text;
    }
    .dashboard-section {
        padding: 48px 0 72px 0;
    }
    .dashboard-card {
        background: #fff;
        border-radius: 24px;
        box-shadow: 0 10px 32px rgba(40,167,69,0.10), 0 1.5px 8px rgba(32,32,32,0.04);
        padding: 36px 32px 28px 32px;
        text-align: center;
        transition: box-shadow 0.3s, transform 0.3s;
        height: 100%;
        position: relative;
        overflow: hidden;
        display: flex;
        flex-direction: column;
    }
    .dashboard-card:hover {
        box-shadow: 0 20px 48px rgba(40,167,69,0.18), 0 4px 24px rgba(32,32,32,0.08);
        transform: translateY(-6px) scale(1.02);
    }
    .dashboard-card-icon {
        font-size: 3rem;
        margin-bottom: 20px;
        color: #28a745;
    }
    .dashboard-card h5 {
        font-weight: 700;
        font-size: 1.2rem;
        margin-bottom: 12px;
        color: #152A16;
    }
    .dashboard-card p {
        color: #666;
        font-size: 0.95rem;
        margin-bottom: 24px;
        line-height: 1.5;
        flex-grow: 1;
    }
    .btn-action {
        font-weight: 700;
        border-radius: 12px;
        font-size: 1rem;
        padding: 10px 24px;
        box-shadow: 0 2px 8px rgba(40,167,69,0.07);
        margin-top: auto;
        align-self: center;
        min-width: 140px;
    }
    .dashboard-title {
        color: #152A16;
        font-weight: 800;
        font-size: 1.8rem;
        letter-spacing: 0.5px;
        text-align: center;
        margin-bottom: 30px;
    }
    .stats-card {
        background: #fff;
        border-radius: 20px;
        box-shadow: 0 8px 24px rgba(40,167,69,0.08);
        padding: 24px;
        text-align: center;
        transition: box-shadow 0.3s, transform 0.3s;
        position: relative;
        overflow: hidden;
    }
    .stats-card:hover {
        box-shadow: 0 16px 40px rgba(40,167,69,0.15);
        transform: translateY(-4px);
    }
    .stats-pending {
        background: linear-gradient(135deg, #fff3cd 0%, #ffe082 100%);
        color: #856404;
    }
    .stats-progress {
        background: linear-gradient(135deg, #d1ecf1 0%, #bee5eb 100%);
        color: #0c5460;
    }
    .stats-completed {
        background: linear-gradient(135deg, #d4edda 0%, #a5d6a7 100%);
        color: #155724;
    }
    .stats-today {
        background: linear-gradient(135deg, #fff3cd 0%, #ffd54f 100%);
        color: #f57f17;
    }
    .stats-icon {
        font-size: 2.5rem;
        margin-bottom: 16px;
        opacity: 0.8;
    }
    .stats-content h5 {
        font-weight: 700;
        font-size: 1.1rem;
        margin-bottom: 8px;
    }
    .stats-content h3 {
        font-weight: 800;
        font-size: 2.2rem;
        margin-bottom: 4px;
    }
    .stats-content small {
        font-size: 0.9rem;
        opacity: 0.8;
    }
    .dashboard-table-card {
        background: #fff;
        border-radius: 20px;
        box-shadow: 0 8px 24px rgba(40,167,69,0.08);
        overflow: hidden;
    }
    .dashboard-table-header {
        background: linear-gradient(135deg, #f8f9fa 0%, #e9ecef 100%);
        padding: 20px 24px;
        border-bottom: 1px solid #dee2e6;
    }
    .dashboard-table-header h5 {
        font-weight: 700;
        font-size: 1.2rem;
        margin: 0;
        color: #152A16;
    }
    .dashboard-table-body {
        padding: 24px;
    }
    .table {
        margin-bottom: 0;
    }
    .table th {
        font-weight: 700;
        color: #152A16;
        border-bottom: 2px solid #dee2e6;
        padding: 16px 12px;
    }
    .table td {
        padding: 16px 12px;
        vertical-align: middle;
    }
    .appointment-id {
        background: #e9ecef;
        color: #495057;
        padding: 6px 12px;
        border-radius: 8px;
        font-weight: 600;
        font-size: 0.9rem;
    }
    .service-badge {
        background: #f8f9fa;
        color: #495057;
        padding: 4px 8px;
        border-radius: 6px;
        font-size: 0.8rem;
        margin-right: 4px;
        display: inline-block;
    }
    .status-badge {
        padding: 6px 12px;
        border-radius: 8px;
        font-weight: 600;
        font-size: 0.85rem;
    }
    .status-pending {
        background: linear-gradient(90deg, #fff3cd 0%, #ffe082 100%);
        color: #856404;
    }
    .status-waiting {
        background: linear-gradient(90deg, #fff3cd 0%, #ffd54f 100%);
        color: #f57f17;
    }
    .status-progress {
        background: linear-gradient(90deg, #d1ecf1 0%, #bee5eb 100%);
        color: #0c5460;
    }
    .status-completed {
        background: linear-gradient(90deg, #d4edda 0%, #a5d6a7 100%);
        color: #155724;
    }
    .status-cancelled {
        background: linear-gradient(90deg, #f8d7da 0%, #f5c6cb 100%);
        color: #721c24;
    }
    .status-other {
        background: linear-gradient(90deg, #e9ecef 0%, #dee2e6 100%);
        color: #495057;
    }
    .technician-info {
        color: #28a745;
        font-weight: 600;
    }
    .technician-info.empty {
        color: #6c757d;
    }
    .empty-state {
        text-align: center;
        padding: 40px 20px;
        color: #6c757d;
    }
    .empty-state i {
        font-size: 3rem;
        margin-bottom: 16px;
        opacity: 0.5;
    }
    .empty-state h5 {
        font-weight: 600;
        margin-bottom: 8px;
    }
    .empty-state p {
        margin-bottom: 0;
        opacity: 0.8;
    }
    @@media (max-width: 991px) {
        .dashboard-card { padding: 24px 20px 20px 20px; }
        .dashboard-section { padding: 24px 0 36px 0; }
    }
    @@media (max-width: 767px) {
        .dashboard-hero h1 { font-size: 1.8rem; }
        .dashboard-title { font-size: 1.4rem; }
        .stats-card { padding: 16px; }
        .stats-content h3 { font-size: 1.8rem; }
    }
</style>

<script>
    // Thêm hiệu ứng hover cho các card thống kê
    document.addEventListener('DOMContentLoaded', function() {
        const statCards = document.querySelectorAll('.stats-card');
        statCards.forEach(card => {
            card.addEventListener('mouseenter', function() {
                this.style.transform = 'translateY(-4px)';
            });
            card.addEventListener('mouseleave', function() {
                this.style.transform = 'translateY(0)';
            });
        });
    });
</script> 