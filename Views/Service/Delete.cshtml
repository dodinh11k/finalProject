@model test_2.Models.Service
@{
    ViewData["Title"] = "Xóa dịch vụ";
}

<style>
    body {
        background-color: #1c1c1c;
        color: #f5f5f5;
    }

    .delete-container {
        max-width: 600px;
        margin: 60px auto;
        padding: 30px;
        background-color: #2b2b2b;
        border-radius: 10px;
        box-shadow: 0 0 12px rgba(255, 0, 0, 0.2);
    }

    .delete-title {
        color: #ffc107;
        font-weight: bold;
        font-size: 1.6rem;
        text-align: center;
        margin-bottom: 30px;
    }

    .alert-danger {
        background-color: #dc3545;
        border: none;
        color: #fff;
        font-size: 1.1rem;
        padding: 20px;
        border-radius: 8px;
        text-align: center;
    }

    .btn-delete {
        background-color: #dc3545;
        color: #fff;
        font-weight: 600;
        border: none;
        padding: 8px 20px;
        border-radius: 5px;
    }

        .btn-delete:hover {
            background-color: #c82333;
        }

    .btn-cancel {
        background-color: #6c757d;
        color: #fff;
        font-weight: 600;
        border: none;
        padding: 8px 20px;
        border-radius: 5px;
        margin-left: 10px;
    }

        .btn-cancel:hover {
            background-color: #5a6268;
        }

    .btn-wrapper {
        display: flex;
        justify-content: center;
        margin-top: 25px;
    }
</style>

<div class="delete-container">
    <div class="delete-title">Xác nhận xóa dịch vụ</div>

    <div class="alert alert-danger">
        Bạn có chắc chắn muốn xóa dịch vụ <strong>"@Model.ServiceName"</strong> không?
    </div>

    <form asp-action="DeleteConfirmed" method="post">
        <input type="hidden" asp-for="ServiceId" />
        <div class="btn-wrapper">
            <button type="submit" class="btn btn-delete">🗑 Xóa</button>
            <a asp-action="AdminList" class="btn btn-cancel">Hủy</a>
        </div>
    </form>
</div>
