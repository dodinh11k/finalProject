@model test_2.Models.Service

@{
    ViewData["Title"] = "Chi tiết dịch vụ";
}

<style>
    .service-hero {
        background: linear-gradient(135deg, #28a745 0%, #20c997 50%, #17a2b8 100%);
        padding: 60px 0;
        margin-top: 80px;
        color: white;
        text-align: center;
        position: relative;
        overflow: hidden;
    }

    .service-hero::before {
        content: '';
        position: absolute;
        top: 0;
        left: 0;
        right: 0;
        bottom: 0;
        background: url('data:image/svg+xml,<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 100 100"><defs><pattern id="grain" width="100" height="100" patternUnits="userSpaceOnUse"><circle cx="50" cy="50" r="1" fill="white" opacity="0.1"/></pattern></defs><rect width="100" height="100" fill="url(%23grain)"/></svg>');
        opacity: 0.2;
    }

    .service-hero h1 {
        font-size: 2.8rem;
        font-weight: 800;
        margin-bottom: 15px;
        position: relative;
        z-index: 2;
        text-shadow: 2px 2px 4px rgba(0,0,0,0.3);
    }

    .service-hero p {
        font-size: 1.1rem;
        opacity: 0.95;
        position: relative;
        z-index: 2;
        font-weight: 300;
        max-width: 600px;
        margin: 0 auto;
    }

    .service-details-section {
        padding: 80px 0;
        background: #f8f9fa;
    }

    .service-details-container {
        max-width: 1200px;
        margin: 0 auto;
        padding: 0 20px;
    }

    .service-details-card {
        background: white;
        border-radius: 20px;
        box-shadow: 0 15px 40px rgba(0,0,0,0.1);
        overflow: hidden;
        position: relative;
    }

    .service-details-card::before {
        content: '';
        position: absolute;
        top: 0;
        left: 0;
        right: 0;
        height: 4px;
        background: linear-gradient(90deg, #28a745, #20c997);
    }

    .service-image-container {
        position: relative;
        overflow: hidden;
    }

    .service-image {
        width: 100%;
        height: 400px;
        object-fit: cover;
        transition: transform 0.3s ease;
    }

    .service-image:hover {
        transform: scale(1.05);
    }

    .service-info {
        padding: 40px;
        color: #2c3e50;
    }

    .service-title {
        font-size: 2.2rem;
        font-weight: 700;
        color: #2c3e50;
        margin-bottom: 30px;
        line-height: 1.2;
    }

    .service-price {
        font-size: 2rem;
        font-weight: 700;
        color: #28a745;
        margin-bottom: 25px;
        display: flex;
        align-items: center;
        gap: 10px;
    }

    .service-price::before {
        content: '💰';
        font-size: 1.5rem;
    }

    .service-description {
        font-size: 1.1rem;
        line-height: 1.7;
        color: #6c757d;
        margin-bottom: 30px;
        padding: 20px;
        background: #f8f9fa;
        border-radius: 12px;
        border-left: 4px solid #28a745;
    }

    .service-details-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
        gap: 20px;
        margin-bottom: 30px;
    }

    .detail-item {
        padding: 20px;
        background: linear-gradient(135deg, #f8f9fa 0%, #e9ecef 100%);
        border-radius: 12px;
        border-left: 4px solid #28a745;
    }

    .detail-label {
        font-size: 0.9rem;
        color: #6c757d;
        text-transform: uppercase;
        letter-spacing: 1px;
        font-weight: 600;
        margin-bottom: 8px;
    }

    .detail-value {
        font-size: 1.1rem;
        font-weight: 700;
        color: #2c3e50;
    }

    .service-actions {
        display: flex;
        gap: 15px;
        flex-wrap: wrap;
        margin-top: 30px;
    }

    .btn-back {
        background: linear-gradient(135deg, #6c757d 0%, #5a6268 100%);
        color: white;
        border: none;
        padding: 12px 25px;
        border-radius: 10px;
        font-weight: 600;
        text-decoration: none;
        transition: all 0.3s ease;
        display: inline-flex;
        align-items: center;
        gap: 8px;
    }

    .btn-back:hover {
        transform: translateY(-2px);
        box-shadow: 0 8px 20px rgba(108, 117, 125, 0.3);
        color: white;
    }

    .btn-book {
        background: linear-gradient(135deg, #28a745 0%, #20c997 100%);
        color: white;
        border: none;
        padding: 12px 25px;
        border-radius: 10px;
        font-weight: 600;
        text-decoration: none;
        transition: all 0.3s ease;
        display: inline-flex;
        align-items: center;
        gap: 8px;
    }

    .btn-book:hover {
        transform: translateY(-2px);
        box-shadow: 0 8px 20px rgba(40, 167, 69, 0.3);
        color: white;
    }

    .floating-shapes {
        position: absolute;
        width: 100%;
        height: 100%;
        overflow: hidden;
        z-index: 1;
    }

    .shape {
        position: absolute;
        background: rgba(255,255,255,0.1);
        border-radius: 50%;
        animation: float 6s ease-in-out infinite;
    }

    .shape:nth-child(1) {
        width: 60px;
        height: 60px;
        top: 20%;
        left: 10%;
        animation-delay: 0s;
    }

    .shape:nth-child(2) {
        width: 40px;
        height: 40px;
        top: 60%;
        right: 10%;
        animation-delay: 2s;
    }

    .shape:nth-child(3) {
        width: 30px;
        height: 30px;
        top: 40%;
        left: 50%;
        animation-delay: 4s;
    }

    @@keyframes float {
        0%, 100% { transform: translateY(0px) rotate(0deg); }
        50% { transform: translateY(-15px) rotate(180deg); }
    }

    .features-section {
        background: white;
        padding: 60px 0;
        margin-top: 40px;
    }

    .features-container {
        max-width: 1200px;
        margin: 0 auto;
        padding: 0 20px;
    }

    .features-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
        gap: 30px;
    }

    .feature-card {
        text-align: center;
        padding: 30px 20px;
        background: linear-gradient(135deg, #f8f9fa 0%, #e9ecef 100%);
        border-radius: 15px;
        box-shadow: 0 5px 15px rgba(0,0,0,0.1);
        transition: transform 0.3s ease;
    }

    .feature-card:hover {
        transform: translateY(-5px);
    }

    .feature-icon {
        font-size: 2.5rem;
        margin-bottom: 15px;
        color: #28a745;
    }

    .feature-title {
        font-size: 1.1rem;
        font-weight: 600;
        color: #2c3e50;
        margin-bottom: 10px;
    }

    .feature-desc {
        color: #6c757d;
        font-size: 0.9rem;
        line-height: 1.5;
    }
</style>

<!-- Hero Section -->
<section class="service-hero">
    <div class="floating-shapes">
        <div class="shape"></div>
        <div class="shape"></div>
        <div class="shape"></div>
    </div>
    <div class="container">
        <h1>@Model.ServiceName</h1>
        <p>Dịch vụ chất lượng cao với đội ngũ kỹ thuật viên chuyên nghiệp</p>
    </div>
</section>

<!-- Service Details Section -->
<section class="service-details-section">
    <div class="service-details-container">
        <div class="service-details-card">
            <div class="row g-0">
                <div class="col-lg-6">
                    <div class="service-image-container">
                        <img src="@(
                             !string.IsNullOrWhiteSpace(Model.image_url)
                             ? Url.Content("~/" + Model.image_url.Trim())
                             : Url.Content("~/images/RuaXe.png")
                                    )"
                             alt="@Model.ServiceName"
                             class="service-image" />
                    </div>
                </div>
                <div class="col-lg-6">
                    <div class="service-info">
                        <h2 class="service-title">@Model.ServiceName</h2>
                        
                        <div class="service-price">
                            @($"{Model.Price:N0} VNĐ")
                        </div>

                        @if (!string.IsNullOrEmpty(Model.Description))
                        {
                            <div class="service-description">
                                @Model.Description
                            </div>
                        }

                        <div class="service-details-grid">
                            <div class="detail-item">
                                <div class="detail-label">Mã dịch vụ</div>
                                <div class="detail-value">@Model.ServiceId</div>
                            </div>
                            <div class="detail-item">
                                <div class="detail-label">Thời gian</div>
                                <div class="detail-value">30-60 phút</div>
                            </div>
                            <div class="detail-item">
                                <div class="detail-label">Bảo hành</div>
                                <div class="detail-value">12 tháng</div>
                            </div>
                            <div class="detail-item">
                                <div class="detail-label">Đánh giá</div>
                                <div class="detail-value">⭐⭐⭐⭐⭐</div>
                            </div>
                        </div>

                        <div class="service-actions">
                            @if (User.IsInRole("Admin"))
                            {
                                <a class="btn-back" asp-controller="Service" asp-action="AdminList">
                                    <i class="fa fa-arrow-left"></i>Quay lại
                                </a>
                            }
                            else
                            {
                                <a class="btn-back" asp-controller="Service" asp-action="PublicList">
                                    <i class="fa fa-arrow-left"></i>Quay lại
                                </a>
                                <a class="btn-book" asp-controller="Appointment" asp-action="CreateMulti">
                                    <i class="fa fa-calendar"></i>Đặt lịch ngay
                                </a>
                            }
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- Features Section -->
<section class="features-section">
    <div class="features-container">
        <div class="features-grid">
            <div class="feature-card">
                <div class="feature-icon">🔧</div>
                <div class="feature-title">Kỹ thuật viên chuyên nghiệp</div>
                <div class="feature-desc">Đội ngũ kỹ thuật viên được đào tạo bài bản và có kinh nghiệm lâu năm</div>
            </div>
            <div class="feature-card">
                <div class="feature-icon">⚡</div>
                <div class="feature-title">Thực hiện nhanh chóng</div>
                <div class="feature-desc">Thời gian thực hiện dịch vụ nhanh chóng, tiết kiệm thời gian của bạn</div>
            </div>
            <div class="feature-card">
                <div class="feature-icon">🛡️</div>
                <div class="feature-title">Bảo hành uy tín</div>
                <div class="feature-desc">Chế độ bảo hành dài hạn, đảm bảo chất lượng dịch vụ</div>
            </div>
            <div class="feature-card">
                <div class="feature-icon">💰</div>
                <div class="feature-title">Giá cả hợp lý</div>
                <div class="feature-desc">Mức giá cạnh tranh, phù hợp với chất lượng dịch vụ</div>
            </div>
        </div>
    </div>
</section>

<!-- FontAwesome -->
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/4.7.0/css/font-awesome.min.css" />
