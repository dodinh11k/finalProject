@model test_2.Models.Service

@{
    ViewData["Title"] = "Thông tin chi tiết dịch vụ";
}

<div class="container mt-4">
    <h2>@Model.ServiceName</h2>

    <div class="row mt-3">
        <div class="col-md-6">
            <img src="@(
                 !string.IsNullOrWhiteSpace(Model.image_url)
                 ? Url.Content("~/" + Model.image_url.Trim())
                 : Url.Content("~/images/RuaXe.png")
                        )" class="img - fluid rounded" alt="@Model.ServiceName" />
        </div>
        <div class="col-md-6">
            <dl class="row">
                <dt class="col-sm-4">Mã dịch vụ:</dt>
                <dd class="col-sm-8">@Model.ServiceId</dd>

                <dt class="col-sm-4">Tên dịch vụ:</dt>
                <dd class="col-sm-8">@Model.ServiceName</dd>

                <dt class="col-sm-4">Giá:</dt>
                <dd class="col-sm-8">@Model.Price.("N0") VNĐ</dd>

                <dt class="col-sm-4">Mô tả:</dt>
                <dd class="col-sm-8">@Model.Description</dd>
            </dl>   
            @if (User.IsInRole("Admin"))
                        {
            <a class="btn btn-secondary" asp-controller="Service" asp-action="AdminList">← Quay lại</a>
                        }
                        else
            {
                <a class="btn btn-secondary" asp-controller="Service" asp-action="PublicList">← Quay lại</a>
            }

        </div>
    </div>
</div>
