@model IEnumerable<test_2.Models.Service>

@{
    ViewData["Title"] = "Quản lý dịch vụ";
}

<style>
    body {
        background-color: #1c1c1c;
        color: #f5f5f5;
    }

    h2 {
        color: #ffc107;
        font-weight: bold;
        margin: 30px 0 20px 0;
    }

    .btn-add {
        background-color: #ffc107;
        border: none;
        color: #000;
        font-weight: bold;
        padding: 8px 16px;
        border-radius: 6px;
        transition: 0.3s ease;
        margin-bottom: 20px;
    }

        .btn-add:hover {
            background-color: #e0a800;
            color: #fff;
        }

    .table-custom {
        background-color: #2b2b2b;
        color: #f1f1f1;
        border-radius: 10px;
        overflow: hidden;
    }

        .table-custom th {
            background-color: #343a40;
            color: #ffc107;
            font-weight: 600;
        }

        .table-custom td {
            vertical-align: middle;
            color: #fff;
        }

        .table-custom a.btn {
            padding: 5px 12px;
            font-size: 0.85rem;
        }

    .btn-warning {
        background-color: #ffca2c;
        color: #000;
        border: none;
    }

        .btn-warning:hover {
            background-color: #e0a800;
            color: #fff;
        }

    .btn-danger {
        background-color: #dc3545;
        color: #fff;
        border: none;
    }

        .btn-danger:hover {
            background-color: #bb2d3b;
        }
</style>

<h2>@ViewData["Title"]</h2>

<a class="btn btn-add"
   asp-controller="Service"
   asp-action="Create"
   asp-route-returnUrl="@Url.Action("AdminList", "Service")">
    ➕ Thêm dịch vụ
</a>

<table class="table table-bordered table-custom">
    <thead>
        <tr>
            <th style="width: 10%;">Mã</th>
            <th style="width: 45%;">Tên dịch vụ</th>
            <th style="width: 20%;">Giá</th>
            <th style="width: 25%; text-align: center;">Thao tác</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var service in Model)
        {
            <tr>
                <td>@service.ServiceId</td>
                <td>@service.ServiceName</td>
                <td>@($"{service.Price:N0} đ")</td>
                <td style="text-align: center;">
                    <a asp-controller="Service"
                       asp-action="Edit"
                       asp-route-id="@service.ServiceId"
                       class="btn btn-sm btn-warning me-2">Sửa</a>

                    <a asp-controller="Service"
                       asp-action="Delete"
                       asp-route-id="@service.ServiceId"
                       class="btn btn-sm btn-danger">Xóa</a>
                </td>
            </tr>
        }
    </tbody>
</table>
