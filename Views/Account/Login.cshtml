    @model test_2.Models.LoginViewModel
@{
    ViewData["Title"] = "Đăng nhập";
}
<link rel="stylesheet" href="~/css/login.css" />

<div class="login-page">
    <div class="form-container">
        <h2>Đăng nhập</h2>
        <form asp-controller="AccountLogin" asp-action="Login" method="post" class="login-form">
            <div class="input-group">
                <input asp-for="Username" class="form-control"  placeholder="Tên đăng nhập"
                       value="@(ViewBag.RememberedUsername ?? "")" />
            </div>
            <div class="input-group">
                <input asp-for="Password" class="form-control" type="password" placeholder="Mật khẩu" required />
                <span asp-validation-for="Password" class="text-danger"></span>
            </div>
            <!-- ✅ Checkbox Remember Me -->
            <div class="form-check mb-3">
                <input class="form-check-input" type="checkbox" name="RememberMe" id="RememberMe" />
                <label class="form-check-label" for="RememberMe">
                    Ghi nhớ đăng nhập
                </label>
            </div>
            <button  type="submit">Đăng nhập</button>
            <a asp-action="LoginByGoogle" asp-controller="Account"
               class="btn btn-outline-danger d-flex align-items-center gap-2 justify-content-center w-100"
               style="height: 45px;" >
                <img src="https://developers.google.com/identity/images/g-logo.png"
                     alt="Google Logo"
                     style="width: 20px; height: 20px;">
                <span>Tiếp tục với Google</span>
            </a>
            @if (ViewBag.Error != null)
            {
                <div class="text-danger mt-2">@ViewBag.Error</div>
            }

            <div class="mt-3 text-center">
                <span>Chưa có tài khoản? </span>
                <a asp-action="Register" asp-controller="AccountRegister">Đăng ký ngay</a>
            </div>
        </form>
    </div>
</div>
@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}