@model test_2.Models.User
@{
    ViewData["Title"] = "Thông tin cá nhân";
}

<div class="container mt-5">
    <h2 class="text-center mb-4">Thông tin cá nhân</h2>

    <div class="row justify-content-center">
        <div class="col-md-6">
            <form asp-action="AccountUpdate" method="post">
                <div class="form-group mb-3">
                    <label for="Username">Tên đăng nhập</label>
                    <input type="text" class="form-control" id="Username" value="@Model.Username" readonly />
                </div>

                <div class="form-group mb-3">
                    <label for="FullName">Họ và tên</label>
                    <input type="text" class="form-control" name="FullName" value="@Model.FullName" />
                </div>

                <div class="form-group mb-3">
                    <label for="Email">Email</label>
                    <input type="email" class="form-control" name="Email" value="@Model.Email" />
                </div>

                <div class="form-group mb-3">
                    <label for="Phone">Số điện thoại</label>
                    <input type="text" class="form-control" name="Phone" value="@Model.Phone" />
                </div>

                <div class="form-group mb-3">
                    <label for="Address">Địa chỉ</label>
                    <input type="text" class="form-control" name="Address" value="@Model.Address" />
                </div>

                <div class="form-group mb-4">
                    <label for="Role">Tiền</label>
                    <input type="text" class="form-control" value="@Model.Amount" readonly />
                </div>

                <div class="form-group mb-4">
                    <label for="Role">Vai trò</label>
                    <input type="text" class="form-control" value="@Model.Role" readonly />
                </div>

                <button type="submit" class="btn btn-primary w-100">Cập nhật thông tin</button>
            </form>
        </div>
    </div>
</div>
