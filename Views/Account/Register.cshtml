@model test_2.Models.RegisterViewModel

@{
    ViewData["Title"] = "Đăng ký";
}

<!-- Wrapper -->
<div class="register-page">
    <div class="register-form-container">
        <h2>Đăng ký tài khoản</h2>

        <form asp-action="Register" asp-controller="AccountRegister" method="post" class="register-form">
            <div class="input-group">
                <input type="text" id="Username" name="Username" placeholder="Tên đăng nhập" required />
            </div>
            <div class="input-group">
                <input type="password" id="Password" name="Password" placeholder="Mật khẩu" required />
            </div>
            <div class="input-group">
                <input type="text" id="FullName" name="FullName" placeholder="Họ và tên" />
            </div>
            <div class="input-group">
                <input type="email" id="Email" name="Email" placeholder="Email" />
            </div>
            <div class="input-group">
                <input type="text" id="Phone" name="Phone" placeholder="Số điện thoại" />
            </div>
            <div class="input-group">
                <input type="text" id="Address" name="Address" placeholder="Địa chỉ" />
            </div>

            <button type="submit">Đăng ký</button>

            @if (ViewBag.Error != null)
            {
                <div class="text-danger mt-2">@ViewBag.Error</div>
            }

            <div class="mt-3">
                <span>Đã có tài khoản?</span>
                <a asp-action="Login" asp-controller="AccountLogin">Đăng nhập</a>
            </div>
        </form>
    </div>
</div>

<!-- CSS -->
<link rel="stylesheet" href="~/css/register.css" asp-append-version="true" />