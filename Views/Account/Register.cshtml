@model test_2.Models.RegisterViewModel

@{
    ViewData["Title"] = "Đăng ký";
}

<!-- Wrapper -->
<div class="register-page">
    <div class="register-form-container">
        <h2>Đăng ký tài khoản</h2>

        <form asp-action="Register" asp-controller="AccountRegister" method="post" class="register-form">
            @Html.AntiForgeryToken()

            <div class="input-group">
                <input asp-for="Username" placeholder="Tên đăng nhập"
                       class="form-control @(ViewData.ModelState["Username"]?.Errors.Count > 0 ? "input-error" : "")" />
                <span asp-validation-for="Username" class="error-text"></span>
            </div>

            <div class="input-group">
                <input asp-for="Password" placeholder="Mật khẩu"
                       class="form-control @(ViewData.ModelState["Password"]?.Errors.Count > 0 ? "input-error" : "")" />
                <span asp-validation-for="Password" class="error-text"></span>
            </div>

            <div class="input-group">
                <input asp-for="FullName" placeholder="Họ và tên"
                       class="form-control @(ViewData.ModelState["FullName"]?.Errors.Count > 0 ? "input-error" : "")" />
                <span asp-validation-for="FullName" class="error-text"></span>
            </div>

            <div class="input-group">
                <input asp-for="Email" placeholder="Email"
                       class="form-control @(ViewData.ModelState["Email"]?.Errors.Count > 0 ? "input-error" : "")" />
                <span asp-validation-for="Email" class="error-text"></span>
            </div>

            <div class="input-group">
                <input asp-for="Phone" placeholder="Số điện thoại"
                       class="form-control @(ViewData.ModelState["Phone"]?.Errors.Count > 0 ? "input-error" : "")" />
                <span asp-validation-for="Phone" class="error-text"></span>
            </div>

            <div class="input-group">
                <input asp-for="Address" placeholder="Địa chỉ"
                       class="form-control @(ViewData.ModelState["Address"]?.Errors.Count > 0 ? "input-error" : "")" />
                <span asp-validation-for="Address" class="error-text"></span>
            </div>


            <button type="submit">Đăng ký</button>

            @if (ViewBag.Error != null)
            {
                <div class="text-danger mt-2">@ViewBag.Error</div>
            }

            <div class="mt-3">
                <span>Đã có tài khoản?</span>
                <a asp-action="Login" asp-controller="AccountLogin">Đăng nhập</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }

    <!-- SweetAlert2 CDN -->
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

    <script>
        document.addEventListener("DOMContentLoaded", function () {
            // Nếu có TempData báo thành công => hiển thị popup + redirect
            const isSuccess = '@TempData["RegisterSuccess"]' === 'true';
            if (isSuccess) {
                Swal.fire({
                    icon: 'success',
                    title: 'Đăng ký thành công!',
                    text: 'Bạn sẽ được chuyển hướng đến trang đăng nhập trong 3 giây.',
                    showConfirmButton: false,
                    timer: 3000,
                    timerProgressBar: true
                });

                setTimeout(() => {
                    window.location.href = '/Account/Login';
                }, 3000);
            }

            // Địa chỉ tự động (nếu dùng định vị)
            if (navigator.geolocation) {
                navigator.geolocation.getCurrentPosition(async function (position) {
                    const lat = position.coords.latitude;
                    const lon = position.coords.longitude;

                    try {
                        const response = await fetch(`https://nominatim.openstreetmap.org/reverse?format=json&lat=${lat}&lon=${lon}`);
                        const data = await response.json();
                        if (data && data.display_name) {
                            document.getElementById("Address").value = data.display_name;
                        }
                    } catch (err) {
                        console.error("Không thể lấy địa chỉ:", err);
                    }
                });
            }
        });
    </script>
}


<!-- CSS -->
<link rel="stylesheet" href="~/css/register.css" asp-append-version="true" />
