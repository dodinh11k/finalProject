@model AppointmentHistoryViewModel

@{
    ViewData["Title"] = "Lịch sử đặt lịch";
}

<div class="container mt-4">
    <div class="row">
        <div class="col-12">
            <div class="d-flex justify-content-between align-items-center mb-4">
                <h2><i class="fa fa-history"></i> Lịch sử đặt lịch (Đã xác nhận & Đã thanh toán)</h2>
                <div>
                    <a asp-action="AllAppointments" class="btn btn-outline-warning me-2">
                        <i class="fa fa-list"></i> Tất cả lịch hẹn
                    </a>
                    <a asp-action="Create" class="btn btn-success">
                        <i class="fa fa-plus"></i> Đặt lịch mới
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    body {
        background-color: #EBE7DE;
        color: #152A16;
    }

    .history-card {
        background: #fff;
        border-radius: 12px;
        padding: 20px 24px;
        box-shadow: 0 4px 16px rgba(21,42,22,0.08);
        border: 1.5px solid #e9ecef;
        margin-bottom: 32px;
        transition: box-shadow 0.2s;
    }
    .history-card:hover {
        box-shadow: 0 8px 24px rgba(21,42,22,0.13);
    }
    .history-card h5 {
        font-weight: 700;
        margin-bottom: 12px;
        color: #152A16;
        font-size: 1.15rem;
    }
    .history-card ul {
        padding-left: 20px;
    }
    .history-card li {
        margin-bottom: 8px;
        line-height: 1.6;
    }
    .status-label {
        font-weight: 600;
        padding: 5px 18px;
        border-radius: 8px;
        font-size: 1.05rem;
        letter-spacing: 0.5px;
        margin-left: 8px;
        display: inline-block;
        min-width: 110px;
        text-align: center;
        box-shadow: 0 2px 8px rgba(0,0,0,0.04);
    }
    .status-Pending {
        background: #fff3cd;
        color: #856404;
        border: 1.5px solid #ffe082;
    }
    .status-Confirmed {
        background: #d1ecf1;
        color: #0c5460;
        border: 1.5px solid #bee5eb;
    }
    .status-Completed {
        background: #d4edda;
        color: #155724;
        border: 1.5px solid #a5d6a7;
    }
    .status-Canceled {
        background: #f8d7da;
        color: #721c24;
        border: 1.5px solid #f5c6cb;
    }
    .status-InProgress {
        background: #d1ecf1;
        color: #0c5460;
        border: 1.5px solid #bee5eb;
    }
    .alert-info {
        background: #fff3cd;
        color: #856404;
        border-radius: 8px;
        padding: 15px;
        border: 1px solid #ffe082;
    }
    .action-buttons {
        margin-top: 18px;
    }
    .action-buttons a {
        display: inline-block;
        margin-right: 10px;
        text-decoration: none;
        font-size: 0.98rem;
        padding: 7px 18px;
        border-radius: 8px;
        transition: 0.2s;
        font-weight: 600;
    }
    .btn-edit {
        background: #ffe082;
        color: #152A16;
        border: none;
    }
    .btn-edit:hover {
        background: #ffd54f;
        color: #152A16;
    }
    .btn-cancel {
        background: #f8d7da;
        color: #721c24;
        border: none;
    }
    .btn-cancel:hover {
        background: #f5c6cb;
        color: #721c24;
    }
    /* Card xe/dịch vụ */
    .vehicle-group-card {
        background: #f8f9fa;
        border: 1px solid #e9ecef;
        border-radius: 8px;
        padding: 12px 16px;
        margin-bottom: 10px;
        font-size: 1rem;
    }
    @@media (max-width: 600px) {
        .history-card {
            padding: 12px 6px;
        }
        .vehicle-group-card {
            padding: 8px 6px;
            font-size: 0.97rem;
        }
        .action-buttons a {
            padding: 7px 10px;
            font-size: 0.95rem;
        }
    }
</style>

<div class="container mt-5 mb-5">
    <h2 class="text-center mb-4" style="color:#152A16; font-weight:bold;">Lịch sử đặt lịch của bạn</h2>

    @if (!Model.Appointments.Any())
    {
        <div class="alert alert-info text-center">Bạn chưa có lịch hẹn nào.</div>
    }
    else
    {
        @foreach (var appt in Model.Appointments.OrderByDescending(a => a.AppointmentId))
        {
            var statusClass = "status-" + (appt.Status?.Replace(" ", "").Replace("_", "") ?? "Pending");
            var technicianNames = string.Join(", ",
                Model.Details
                    .Where(d => d.AppointmentId == appt.AppointmentId && d.Technician != null)
                    .Select(d => d.Technician.FullName ?? d.Technician.Username)
                    .Where(name => !string.IsNullOrEmpty(name))
            );
            if (string.IsNullOrEmpty(technicianNames))
            {
                technicianNames = "Chưa phân công";
            }
            // Lấy review cho từng appointment (nếu có)
            var review = Model.Details
                .Select(d => d.Vehicle?.User?.Reviews)
                .SelectMany(r => r ?? new List<test_2.Models.Review>())
                .FirstOrDefault(r => r.UserId == appt.UserId && r.GarageId == appt.Garage?.GarageId);

            <div class="history-card mb-4">
                <div style="display: flex; align-items: center; justify-content: space-between;">
                    <h5 style="margin-bottom:0;">
                        <span style="font-size:0.98rem; color:#888; font-weight:400;">#@appt.AppointmentId</span>
                        &nbsp;Ngày hẹn: <span style="font-weight:700;">@(appt.AppointmentTime.HasValue ? appt.AppointmentTime.Value.ToString("dd/MM/yyyy HH:mm") : "Chưa đặt")</span>
                    </h5>
                </div>
                <p><strong>Garage:</strong> @(appt.Garage?.Address ?? "Không rõ")</p>
                <p><i class="fa fa-user text-success"></i> <strong>Kỹ thuật viên:</strong> @technicianNames</p>
                <p><strong>Ghi chú:</strong> @(string.IsNullOrWhiteSpace(appt.Notes) ? "(Không có ghi chú)" : appt.Notes)</p>
                <p>
                    <strong>Trạng thái:</strong>
                    <span class="status-label @statusClass">
                        @(appt.Status switch {
                            "Pending" => "Chờ xác nhận",
                            "In_Progress" => "Đang thực hiện",
                            _ => appt.Status
                        })
                    </span>
                    @if (appt.Status == "Pending")
                    {
                        <span class="text-success ms-2">
                            <i class="fa fa-check-circle"></i> Đã thanh toán
                        </span>
                    }
                </p>
                <h6 class="mt-3">Thông tin xe và dịch vụ:</h6>
                @{
                    var vehicleGroups = Model.Details.Where(d => d.AppointmentId == appt.AppointmentId)
                                                   .GroupBy(d => d.VehicleId)
                                                   .ToList();
                }
                
                @foreach (var vehicleGroup in vehicleGroups)
                {
                    var firstDetail = vehicleGroup.First();
                    var vehicle = firstDetail.Vehicle;
                    var services = vehicleGroup.Select(d => d.Service?.ServiceName).Where(s => !string.IsNullOrEmpty(s)).ToList();
                    <div class="vehicle-group-card">
                        <strong>Xe @(vehicleGroups.IndexOf(vehicleGroup) + 1):</strong>
                        @($"{vehicle?.Make ?? "Không rõ"} {vehicle?.Model ?? ""}")
                        (@(vehicle?.LicensePlate ?? "Không rõ"))<br />S
                        <strong>Dịch vụ:</strong> @string.Join(", ", services)<br />
                        <strong>Số dịch vụ:</strong> @services.Count
                    </div>
                }

                @if (appt.Status == "Pending")
                {
                    <div class="action-buttons">
                        @if (Model.Details.Count(d => d.AppointmentId == appt.AppointmentId) > 1)
                        {
                            <a asp-action="EditMulti" asp-route-id="@appt.AppointmentId" class="btn-edit">Sửa</a>
                        }
                        else
                        {
                            <a asp-action="Edit" asp-route-id="@appt.AppointmentId" class="btn-edit">Sửa</a>
                        }
                        <a asp-action="Cancel" asp-route-id="@appt.AppointmentId"
                           class="btn-cancel"
                           onclick="return confirm('Bạn có chắc chắn muốn huỷ lịch hẹn này?');">
                            Huỷ
                        </a>
                    </div>
                }
                 @{
    var reviewForCompletedStatus = Model.Reviews.FirstOrDefault(r => r.AppointmentId == appt.AppointmentId);
}

@if (appt.Status == "Completed")
{
    var hasPaid = Model.    Payments != null && Model.Payments.Any(p => p.AppointmentId == appt.AppointmentId && p.Status == "Success");
    if (!hasPaid)
    {
        <form method="post" action="/payment/create" style="display:inline;">
            <input type="hidden" name="amount" value="@appt.TotalAmount" />
            <input type="hidden" name="description" value="Thanh toán lịch hẹn #@appt.AppointmentId" />
            <input type="hidden" name="appointmentId" value="@appt.AppointmentId" />
            <button type="submit" class="btn btn-success btn-sm">
                <i class="fa fa-credit-card"></i> Thanh toán
            </button>
        </form>
    }
    else
    {
        <span class="text-success"><i class="fa fa-check-circle"></i> Đã thanh toán</span>
        var reviewForCompletedStatusInner = Model.Reviews.FirstOrDefault(r => r.AppointmentId == appt.AppointmentId);
        if (reviewForCompletedStatusInner != null)
        {
            <div class="review-box" style="background:#f8f9fa; border:1px solid #e9ecef; border-radius:8px; padding:14px 18px; margin-top:12px;">
                <div style="font-weight:600; color:#152A16; margin-bottom:4px;">Đánh giá của bạn:</div>
                <div style="color:#ffc107; font-size:1.2rem; margin-bottom:2px;">
                    @for (int i = 1; i <= (reviewForCompletedStatusInner.Rating ?? 0); i++)
                    {
                        <span>&#9733;</span>
                    }
                    @for (int i = (reviewForCompletedStatusInner.Rating ?? 0) + 1; i <= 5; i++)
                    {
                        <span style="color:#e4e5e9">&#9733;</span>
                    }
                </div>
                <div style="font-style:italic; color:#444; margin-bottom:2px;">@reviewForCompletedStatusInner.Comment</div>
                <div style="font-size:0.95rem; color:#888;">@reviewForCompletedStatusInner.CreatedAt?.ToString("dd/MM/yyyy HH:mm")</div>
            </div>
        }
        else
        {
            <div class="action-buttons">
                <a asp-action="Review" asp-route-id="@appt.AppointmentId" class="btn-edit">Đánh giá</a>
            </div>
        }
    }
}
            </div>
        }
    }
</div>
