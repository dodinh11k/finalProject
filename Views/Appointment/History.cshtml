@model AppointmentHistoryViewModel

@{
    ViewData["Title"] = "Lịch sử đặt lịch";
}

<h2>Lịch sử đặt lịch của bạn</h2>

@if (!Model.Appointments.Any())
{
    <p>Không có lịch hẹn nào.</p>
}
else
{
    @foreach (var appt in Model.Appointments.OrderByDescending(a => a.AppointmentTime))
    {
        <div class="card mb-3 p-3 shadow-sm">
            <h5>
                Ngày hẹn:
                @(appt.AppointmentTime.HasValue
                    ? appt.AppointmentTime.Value.ToString("dd/MM/yyyy HH:mm")
                    : "Chưa đặt")
            </h5>

            <p><strong>Garage:</strong> @(appt.Garage?.Address ?? "Không rõ")</p>
            <p><strong>Kỹ thuật viên:</strong> @(appt.Technician?.FullName ?? "Không rõ")</p>
            <p><strong>Ghi chú:</strong> @(string.IsNullOrWhiteSpace(appt.Notes) ? "(Không có)" : appt.Notes)</p>
            <p><strong>Trạng thái:</strong> @appt.Status</p>

            <h6 class="mt-3">Dịch vụ và xe:</h6>
            <ul>
                @foreach (var detail in Model.Details.Where(d => d.AppointmentId == appt.AppointmentId))
                {
                    <li>
                        <strong>Xe:</strong> @($"{detail.Vehicle?.Make ?? "Không rõ"} {detail.Vehicle?.Model ?? ""}")
                        (@(detail.Vehicle?.LicensePlate ?? "Không rõ"))<br />
                        <strong>Dịch vụ:</strong> @(detail.Service?.ServiceName ?? "Không rõ")<br />
                        <strong>Số lượng:</strong> @detail.Quantity
                    </li>
                }
            </ul>
        </div>
    }
}
