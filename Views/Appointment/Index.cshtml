@{
    ViewData["Title"] = "Đặt lịch hẹn";
}

<style>
    .appointment-hero {
        background: linear-gradient(135deg, #28a745 0%, #20c997 50%, #17a2b8 100%);
        padding: 80px 0;
        margin-top: 80px;
        color: white;
        text-align: center;
        position: relative;
        overflow: hidden;
    }

    .appointment-hero::before {
        content: '';
        position: absolute;
        top: 0;
        left: 0;
        right: 0;
        bottom: 0;
        background: url('data:image/svg+xml,<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 100 100"><defs><pattern id="grain" width="100" height="100" patternUnits="userSpaceOnUse"><circle cx="50" cy="50" r="1" fill="white" opacity="0.1"/></pattern></defs><rect width="100" height="100" fill="url(%23grain)"/></svg>');
        opacity: 0.2;
    }

    .appointment-hero h1 {
        font-size: 3.2rem;
        font-weight: 800;
        margin-bottom: 20px;
        position: relative;
        z-index: 2;
        text-shadow: 2px 2px 4px rgba(0,0,0,0.3);
    }

    .appointment-hero p {
        font-size: 1.3rem;
        opacity: 0.95;
        position: relative;
        z-index: 2;
        font-weight: 300;
        max-width: 600px;
        margin: 0 auto;
    }

    .appointment-section {
        padding: 80px 0;
        background: #f8f9fa;
    }

    .appointment-container {
        max-width: 1200px;
        margin: 0 auto;
        padding: 0 20px;
    }

    .appointment-title {
        text-align: center;
        margin-bottom: 50px;
    }

    .appointment-title h2 {
        font-size: 2.5rem;
        font-weight: 700;
        color: #2c3e50;
        margin-bottom: 15px;
    }

    .appointment-title p {
        font-size: 1.1rem;
        color: #6c757d;
        max-width: 600px;
        margin: 0 auto;
    }

    .choice-cards {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(400px, 1fr));
        gap: 40px;
        margin-top: 40px;
    }

    .choice-card {
        background: white;
        border-radius: 20px;
        box-shadow: 0 15px 40px rgba(0,0,0,0.1);
        padding: 40px;
        text-align: center;
        transition: all 0.3s ease;
        cursor: pointer;
        text-decoration: none;
        color: #2c3e50;
        position: relative;
        overflow: hidden;
        border: none;
    }

    .choice-card::before {
        content: '';
        position: absolute;
        top: 0;
        left: 0;
        right: 0;
        height: 4px;
        background: linear-gradient(90deg, #28a745, #20c997);
    }

    .choice-card:hover {
        transform: translateY(-10px);
        box-shadow: 0 25px 50px rgba(0,0,0,0.15);
        text-decoration: none;
        color: #2c3e50;
    }

    .choice-card h3 {
        font-size: 1.8rem;
        font-weight: 700;
        color: #2c3e50;
        margin-bottom: 20px;
        line-height: 1.2;
    }

    .choice-card p {
        font-size: 1.1rem;
        color: #6c757d;
        margin-bottom: 25px;
        line-height: 1.6;
    }

    .choice-icon {
        font-size: 4rem;
        margin-bottom: 25px;
        color: #28a745;
        transition: transform 0.3s ease;
    }

    .choice-card:hover .choice-icon {
        transform: scale(1.1);
    }

    .features-list {
        text-align: left;
        margin: 25px 0;
        list-style: none;
        padding: 0;
    }

    .features-list li {
        margin-bottom: 12px;
        color: #6c757d;
        font-size: 1rem;
        display: flex;
        align-items: center;
        gap: 10px;
    }

    .features-list li::before {
        content: "✓";
        color: #28a745;
        font-weight: bold;
        font-size: 1.1rem;
        background: #e8f5e8;
        border-radius: 50%;
        width: 20px;
        height: 20px;
        display: flex;
        align-items: center;
        justify-content: center;
    }

    .btn-choice {
        background: linear-gradient(135deg, #28a745 0%, #20c997 100%);
        color: white;
        border: none;
        border-radius: 12px;
        padding: 15px 30px;
        font-weight: 600;
        font-size: 1.1rem;
        transition: all 0.3s ease;
        text-decoration: none;
        display: inline-block;
        margin-top: 20px;
    }

    .btn-choice:hover {
        transform: translateY(-2px);
        box-shadow: 0 10px 25px rgba(40, 167, 69, 0.3);
        color: white;
        text-decoration: none;
    }

    .btn-choice.multi {
        background: linear-gradient(135deg, #17a2b8 0%, #20c997 100%);
    }

    .btn-choice.multi:hover {
        box-shadow: 0 10px 25px rgba(23, 162, 184, 0.3);
    }

    .history-section {
        background: white;
        padding: 60px 0;
        margin-top: 40px;
    }

    .history-container {
        max-width: 800px;
        margin: 0 auto;
        text-align: center;
    }

    .btn-history {
        background: linear-gradient(135deg, #6c757d 0%, #5a6268 100%);
        color: white;
        border: none;
        padding: 15px 30px;
        border-radius: 12px;
        font-weight: 600;
        font-size: 1.1rem;
        transition: all 0.3s ease;
        text-decoration: none;
        display: inline-flex;
        align-items: center;
        gap: 10px;
    }

    .btn-history:hover {
        transform: translateY(-2px);
        box-shadow: 0 10px 25px rgba(108, 117, 125, 0.3);
        color: white;
        text-decoration: none;
    }

    .floating-shapes {
        position: absolute;
        width: 100%;
        height: 100%;
        overflow: hidden;
        z-index: 1;
    }

    .shape {
        position: absolute;
        background: rgba(255,255,255,0.1);
        border-radius: 50%;
        animation: float 6s ease-in-out infinite;
    }

    .shape:nth-child(1) {
        width: 80px;
        height: 80px;
        top: 20%;
        left: 10%;
        animation-delay: 0s;
    }

    .shape:nth-child(2) {
        width: 60px;
        height: 60px;
        top: 60%;
        right: 10%;
        animation-delay: 2s;
    }

    .shape:nth-child(3) {
        width: 40px;
        height: 40px;
        top: 40%;
        left: 50%;
        animation-delay: 4s;
    }

    @@keyframes float {
        0%, 100% { transform: translateY(0px) rotate(0deg); }
        50% { transform: translateY(-20px) rotate(180deg); }
    }

    .stats-section {
        background: linear-gradient(135deg, #f8f9fa 0%, #e9ecef 100%);
        padding: 40px 0;
        margin-top: 40px;
    }

    .stats-container {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
        gap: 30px;
        max-width: 1200px;
        margin: 0 auto;
        padding: 0 20px;
    }

    .stat-card {
        text-align: center;
        padding: 30px 20px;
        background: white;
        border-radius: 15px;
        box-shadow: 0 5px 15px rgba(0,0,0,0.1);
    }

    .stat-number {
        font-size: 2.5rem;
        font-weight: 700;
        color: #28a745;
        margin-bottom: 10px;
    }

    .stat-label {
        color: #6c757d;
        font-size: 0.9rem;
        text-transform: uppercase;
        letter-spacing: 1px;
        font-weight: 600;
    }

    @@media (max-width: 768px) {
        .choice-cards {
            grid-template-columns: 1fr;
        }
        
        .appointment-hero h1 {
            font-size: 2.5rem;
        }
        
        .appointment-title h2 {
            font-size: 2rem;
        }
    }
</style>

<!-- Hero Section -->
<section class="appointment-hero">
    <div class="floating-shapes">
        <div class="shape"></div>
        <div class="shape"></div>
        <div class="shape"></div>
    </div>
    <div class="container">
        <h1>Đặt lịch hẹn</h1>
        <p>Chọn loại đặt lịch phù hợp với nhu cầu của bạn</p>
    </div>
</section>

<!-- Appointment Section -->
<section class="appointment-section">
    <div class="appointment-container">
        <div class="appointment-title">
            <h2>Chọn loại đặt lịch</h2>
            <p>Chúng tôi cung cấp hai tùy chọn đặt lịch để phù hợp với mọi nhu cầu</p>
        </div>
        
        <div class="choice-cards">
            <a href="@Url.Action("Create", "Appointment")" class="choice-card">
                <div class="choice-icon">
                    <i class="fa fa-car"></i>
                </div>
                <h3>Đặt lịch 1 xe</h3>
                <p>Phù hợp khi bạn chỉ cần đặt lịch cho một chiếc xe với các dịch vụ cần thiết.</p>
                
                <ul class="features-list">
                    <li>Đặt lịch nhanh chóng</li>
                    <li>Chọn nhiều dịch vụ cho 1 xe</li>
                    <li>Giao diện đơn giản</li>
                    <li>Thao tác dễ dàng</li>
                </ul>
                
                <div class="btn-choice">Chọn đặt lịch 1 xe</div>
            </a>
            
            <a href="@Url.Action("CreateMulti", "Appointment")" class="choice-card">
                <div class="choice-icon">
                    <i class="fa fa-cars"></i>
                </div>
                <h3>Đặt lịch nhiều xe</h3>
                <p>Lý tưởng khi bạn cần đặt lịch cho nhiều xe cùng lúc, mỗi xe có thể có dịch vụ riêng biệt.</p>
                
                <ul class="features-list">
                    <li>Đặt lịch cho nhiều xe</li>
                    <li>Mỗi xe có dịch vụ độc lập</li>
                    <li>Tiết kiệm thời gian</li>
                    <li>Quản lý tập trung</li>
                </ul>
                
                <div class="btn-choice multi">Chọn đặt lịch nhiều xe</div>
            </a>
        </div>
    </div>
</section>

<!-- Stats Section -->
<section class="stats-section">
    <div class="stats-container">
        <div class="stat-card">
            <div class="stat-number">24/7</div>
            <div class="stat-label">Hỗ trợ</div>
        </div>
        <div class="stat-card">
            <div class="stat-number">100%</div>
            <div class="stat-label">Đảm bảo</div>
        </div>
        <div class="stat-card">
            <div class="stat-number">5+</div>
            <div class="stat-label">Năm kinh nghiệm</div>
        </div>
        <div class="stat-card">
            <div class="stat-number">1000+</div>
            <div class="stat-label">Khách hàng</div>
        </div>
    </div>
</section>

<!-- History Section -->
<section class="history-section">
    <div class="history-container">
        <a href="@Url.Action("History", "Appointment")" class="btn-history">
            <i class="fa fa-history"></i>
            Xem lịch sử đặt lịch
        </a>
    </div>
</section>

<!-- FontAwesome -->
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/4.7.0/css/font-awesome.min.css" /> 