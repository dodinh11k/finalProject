@{
    ViewData["Title"] = "Đặt lịch hẹn";
}

<style>
    body {
        background-color: #EBE7DE;
        color: #152A16;
    }

    .appointment-choice-container {
        background-color: #fff;
        border-radius: 12px;
        padding: 40px 30px;
        max-width: 800px;
        margin: 50px auto;
        box-shadow: 0 4px 20px rgba(0,0,0,0.1);
    }

    h2 {
        color: #152A16;
        text-align: center;
        margin-bottom: 30px;
        font-weight: bold;
    }

    .choice-cards {
        display: flex;
        gap: 30px;
        margin-top: 30px;
    }

    .choice-card {
        flex: 1;
        background-color: #f8f9fa;
        border: 2px solid #e9ecef;
        border-radius: 12px;
        padding: 30px;
        text-align: center;
        transition: 0.3s ease;
        cursor: pointer;
        text-decoration: none;
        color: #152A16;
    }

    .choice-card:hover {
        border-color: #152A16;
        transform: translateY(-5px);
        box-shadow: 0 8px 25px rgba(0,0,0,0.15);
        text-decoration: none;
        color: #152A16;
    }

    .choice-card h3 {
        color: #152A16;
        margin-bottom: 15px;
        font-weight: bold;
    }

    .choice-card p {
        color: #6c757d;
        margin-bottom: 20px;
        line-height: 1.6;
    }

    .choice-icon {
        font-size: 3rem;
        margin-bottom: 20px;
        color: #152A16;
    }

    .btn-choice {
        background-color: #152A16;
        color: white;
        border: none;
        border-radius: 8px;
        padding: 12px 25px;
        font-weight: bold;
        transition: 0.3s ease;
        text-decoration: none;
        display: inline-block;
    }

    .btn-choice:hover {
        background-color: #0F1F10;
        color: white;
        text-decoration: none;
    }

    .btn-choice.multi {
        background-color: #28a745;
    }

    .btn-choice.multi:hover {
        background-color: #218838;
    }

    .features-list {
        text-align: left;
        margin-top: 15px;
    }

    .features-list li {
        margin-bottom: 8px;
        color: #6c757d;
        font-size: 0.9rem;
    }

    .features-list li:before {
        content: "✓ ";
        color: #28a745;
        font-weight: bold;
    }

    media (max-width: 768px) {
        .choice-cards {
            flex-direction: column;
        }
    }
</style>

<div class="appointment-choice-container">
    <h2>Chọn loại đặt lịch</h2>
    
    <div class="choice-cards">
        <a href="@Url.Action("Create", "Appointment")" class="choice-card">
            <div class="choice-icon">
                <i class="fa fa-car"></i>
            </div>
            <h3>Đặt lịch 1 xe</h3>
            <p>Phù hợp khi bạn chỉ cần đặt lịch cho một chiếc xe với các dịch vụ cần thiết.</p>
            
            <ul class="features-list">
                <li>Đặt lịch nhanh chóng</li>
                <li>Chọn nhiều dịch vụ cho 1 xe</li>
                <li>Giao diện đơn giản</li>
            </ul>
            
            <div class="mt-3">
                <span class="btn-choice">Chọn</span>
            </div>
        </a>
        
        <a href="@Url.Action("CreateMulti", "Appointment")" class="choice-card">
            <div class="choice-icon">
                <i class="fa fa-cars"></i>
            </div>
            <h3>Đặt lịch nhiều xe</h3>
            <p>Lý tưởng khi bạn cần đặt lịch cho nhiều xe cùng lúc, mỗi xe có thể có dịch vụ riêng biệt.</p>
            
            <ul class="features-list">
                <li>Đặt lịch cho nhiều xe</li>
                <li>Mỗi xe có dịch vụ độc lập</li>
                <li>Tiết kiệm thời gian</li>
                <li>Quản lý tập trung</li>
            </ul>
            
            <div class="mt-3">
                <span class="btn-choice multi">Chọn</span>
            </div>
        </a>
    </div>
    
    <div class="text-center mt-4">
        <a href="@Url.Action("History", "Appointment")" class="btn btn-outline-secondary">
            <i class="fa fa-history"></i> Xem lịch sử đặt lịch
        </a>
    </div>
</div>

<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/4.7.0/css/font-awesome.min.css" /> 