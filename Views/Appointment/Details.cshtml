@model test_2.Models.Appointment

@{
    ViewData["Title"] = "Chi tiết lịch hẹn";
}

<h2>@ViewData["Title"]</h2>

<div>
    <p><strong>Khách hàng:</strong> @Model.User?.FullName</p>
    <p><strong>Số điện thoại:</strong> @Model.User?.Phone</p>
    <p><strong>Dịch vụ:</strong> @Model.Service?.ServiceName</p>
    <p><strong>Garage:</strong> @Model.Garage?.Address</p>
    
    <p><strong>Thời gian hẹn:</strong> @(Model.AppointmentTime?.ToString("dd/MM/yyyy HH:mm") ?? "Chưa có thời gian")</p>
    <p><strong>Trạng thái:</strong> @Model.Status</p>
    <p><strong>Ghi chú:</strong> @Model.Notes</p>
</div>

<a asp-action="Create">→ Đặt lịch mới</a>
