@model test_2.Models.AppointmentHistoryViewModel
@using test_2.Models
@using System.Linq
@using System.Collections.Generic
@{
    ViewData["Title"] = "Tất cả lịch hẹn";
}

<style>
    .appointments-hero {
        background: linear-gradient(135deg, #28a745 0%, #20c997 50%, #17a2b8 100%);
        padding: 60px 0;
        margin-top: 80px;
        color: white;
        text-align: center;
        position: relative;
        overflow: hidden;
    }

    .appointments-hero::before {
        content: '';
        position: absolute;
        top: 0;
        left: 0;
        right: 0;
        bottom: 0;
        background: url('data:image/svg+xml,<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 100 100"><defs><pattern id="grain" width="100" height="100" patternUnits="userSpaceOnUse"><circle cx="50" cy="50" r="1" fill="white" opacity="0.1"/></pattern></defs><rect width="100" height="100" fill="url(%23grain)"/></svg>');
        opacity: 0.2;
    }

    .appointments-hero h1 {
        font-size: 2.8rem;
        font-weight: 800;
        margin-bottom: 15px;
        position: relative;
        z-index: 2;
        text-shadow: 2px 2px 4px rgba(0,0,0,0.3);
    }

    .appointments-hero p {
        font-size: 1.1rem;
        opacity: 0.95;
        position: relative;
        z-index: 2;
        font-weight: 300;
        max-width: 600px;
        margin: 0 auto;
    }

    .appointments-section {
        padding: 80px 0;
        background: #f8f9fa;
    }

    .appointments-container {
        max-width: 1200px;
        margin: 0 auto;
        padding: 0 20px;
    }

    .appointments-header {
        text-align: center;
        margin-bottom: 50px;
    }

    .appointments-header h2 {
        font-size: 2.5rem;
        font-weight: 700;
        color: #2c3e50;
        margin-bottom: 15px;
    }

    .appointments-header p {
        font-size: 1.1rem;
        color: #6c757d;
        max-width: 600px;
        margin: 0 auto;
    }

    .appointment-card {
        background: white;
        border-radius: 20px;
        box-shadow: 0 15px 40px rgba(0,0,0,0.1);
        overflow: hidden;
        position: relative;
        border: none;
        transition: all 0.3s ease;
        height: 100%;
    }

    .appointment-card::before {
        content: '';
        position: absolute;
        top: 0;
        left: 0;
        right: 0;
        height: 4px;
        background: linear-gradient(90deg, #28a745, #20c997);
    }

    .appointment-card:hover {
        transform: translateY(-5px);
        box-shadow: 0 25px 50px rgba(0,0,0,0.15);
    }

    .card-header {
        background: linear-gradient(135deg, #f8f9fa 0%, #e9ecef 100%);
        border-bottom: 2px solid #e9ecef;
        padding: 20px;
    }

    .card-header h5 {
        font-weight: 700;
        color: #2c3e50;
        margin: 0;
        font-size: 1.2rem;
    }

    .badge {
        padding: 8px 16px;
        border-radius: 12px;
        font-weight: 600;
        font-size: 0.9rem;
        border: none;
    }

    .bg-warning {
        background: linear-gradient(135deg, #fff3cd 0%, #ffe082 100%);
        color: #856404;
    }

    .bg-success {
        background: linear-gradient(135deg, #d4edda 0%, #c3e6cb 100%);
        color: #155724;
    }

    .bg-info {
        background: linear-gradient(135deg, #d1ecf1 0%, #bee5eb 100%);
        color: #0c5460;
    }

    .bg-primary {
        background: linear-gradient(135deg, #cce5ff 0%, #b3d9ff 100%);
        color: #004085;
    }

    .bg-danger {
        background: linear-gradient(135deg, #f8d7da 0%, #f5c6cb 100%);
        color: #721c24;
    }

    .bg-secondary {
        background: linear-gradient(135deg, #e2e3e5 0%, #d6d8db 100%);
        color: #383d41;
    }

    .card-body {
        padding: 25px;
    }

    .card-body p {
        margin-bottom: 12px;
        font-size: 1rem;
        color: #2c3e50;
        display: flex;
        align-items: center;
        gap: 10px;
    }

    .card-body strong {
        color: #28a745;
        font-weight: 600;
        min-width: 80px;
    }

    .card-body i {
        color: #28a745;
        width: 16px;
    }

    .list-unstyled {
        margin: 10px 0;
        padding-left: 0;
    }

    .list-unstyled li {
        display: flex;
        align-items: center;
        gap: 8px;
        margin-bottom: 8px;
        color: #6c757d;
        font-size: 0.95rem;
    }

    .list-unstyled i {
        color: #28a745;
        font-size: 0.9rem;
    }

    .text-decoration-line-through {
        text-decoration: line-through;
        color: #6c757d;
        margin-right: 8px;
    }

    .text-success {
        color: #28a745;
        font-weight: 600;
    }

    .text-info {
        color: #17a2b8;
        font-weight: 600;
    }

    .card-footer {
        background: linear-gradient(135deg, #f8f9fa 0%, #e9ecef 100%);
        border-top: 2px solid #e9ecef;
        padding: 20px;
    }

    .btn {
        padding: 10px 20px;
        border-radius: 12px;
        font-weight: 600;
        font-size: 0.9rem;
        transition: all 0.3s ease;
        border: none;
        text-decoration: none;
        display: inline-flex;
        align-items: center;
        gap: 8px;
    }

    .btn-primary {
        background: linear-gradient(135deg, #007bff 0%, #0056b3 100%);
        color: white;
    }

    .btn-primary:hover {
        transform: translateY(-2px);
        box-shadow: 0 10px 25px rgba(0, 123, 255, 0.3);
        color: white;
        text-decoration: none;
    }

    .btn-success {
        background: linear-gradient(135deg, #28a745 0%, #20c997 100%);
        color: white;
    }

    .btn-success:hover {
        transform: translateY(-2px);
        box-shadow: 0 10px 25px rgba(40, 167, 69, 0.3);
        color: white;
        text-decoration: none;
    }

    .btn-outline-primary {
        background: transparent;
        color: #007bff;
        border: 2px solid #007bff;
    }

    .btn-outline-primary:hover {
        background: #007bff;
        color: white;
        transform: translateY(-2px);
        box-shadow: 0 10px 25px rgba(0, 123, 255, 0.3);
        text-decoration: none;
    }

    .empty-state {
        text-align: center;
        padding: 60px 20px;
        background: white;
        border-radius: 20px;
        box-shadow: 0 15px 40px rgba(0,0,0,0.1);
    }

    .empty-state i {
        font-size: 4rem;
        color: #6c757d;
        margin-bottom: 20px;
    }

    .empty-state h3 {
        color: #2c3e50;
        font-weight: 700;
        margin-bottom: 15px;
    }

    .empty-state p {
        color: #6c757d;
        font-size: 1.1rem;
        margin-bottom: 25px;
    }

    .btn-create {
        background: linear-gradient(135deg, #28a745 0%, #20c997 100%);
        color: white;
        border: none;
        padding: 15px 30px;
        border-radius: 12px;
        font-weight: 600;
        font-size: 1.1rem;
        transition: all 0.3s ease;
        text-decoration: none;
        display: inline-flex;
        align-items: center;
        gap: 10px;
    }

    .btn-create:hover {
        transform: translateY(-2px);
        box-shadow: 0 10px 25px rgba(40, 167, 69, 0.3);
        color: white;
        text-decoration: none;
    }

    .floating-shapes {
        position: absolute;
        width: 100%;
        height: 100%;
        overflow: hidden;
        z-index: 1;
    }

    .shape {
        position: absolute;
        background: rgba(255,255,255,0.1);
        border-radius: 50%;
        animation: float 6s ease-in-out infinite;
    }

    .shape:nth-child(1) {
        width: 60px;
        height: 60px;
        top: 20%;
        left: 10%;
        animation-delay: 0s;
    }

    .shape:nth-child(2) {
        width: 40px;
        height: 40px;
        top: 60%;
        right: 10%;
        animation-delay: 2s;
    }

    .shape:nth-child(3) {
        width: 30px;
        height: 30px;
        top: 40%;
        left: 50%;
        animation-delay: 4s;
    }

    @@keyframes float {
        0%, 100% { transform: translateY(0px) rotate(0deg); }
        50% { transform: translateY(-15px) rotate(180deg); }
    }

    @@media (max-width: 768px) {
        .appointments-hero h1 {
            font-size: 2.2rem;
        }
        
        .appointments-header h2 {
            font-size: 2rem;
        }
        
        .card-body {
            padding: 20px;
        }
        
        .btn {
            padding: 8px 16px;
            font-size: 0.85rem;
        }
    }
</style>

<!-- Hero Section -->
<section class="appointments-hero">
    <div class="floating-shapes">
        <div class="shape"></div>
        <div class="shape"></div>
        <div class="shape"></div>
    </div>
    <div class="container">
        <h1>Tất cả lịch hẹn</h1>
        <p>Xem và quản lý tất cả lịch hẹn của bạn</p>
    </div>
</section>

<!-- Appointments Section -->
<section class="appointments-section">
    <div class="appointments-container">
        <div class="appointments-header">
        </div>

        @if (!Model.Appointments.Any())
        {
            <div class="empty-state">
                <i class="fa fa-calendar-times-o"></i>
                <h3>Chưa có lịch hẹn nào</h3>
                <p>Bạn chưa có lịch hẹn nào trong hệ thống.</p>
                <a href="@Url.Action("Create", "Appointment")" class="btn-create">
                    <i class="fa fa-plus"></i>
                    Đặt lịch ngay
                </a>
            </div>
        }
        else
        {
            <div class="row">
                @foreach (var appointment in Model.Appointments)
                {
                    var details = Model.Details.Where(d => d.AppointmentId == appointment.AppointmentId).ToList();
                    var totalServicePrice = details.Sum(d => d.Service?.Price ?? 0);
                    var discountAmount = appointment.DiscountAmount ?? 0;
                    var totalAmount = totalServicePrice - discountAmount;

                    <div class="col-md-6 col-lg-4 mb-4">
                        <div class="appointment-card">
                            <div class="card-header">
                                <div class="d-flex justify-content-between align-items-center">
                                    <h5>Lịch hẹn #@appointment.AppointmentId</h5>
                                    <span class="badge @GetStatusBadgeClass(appointment.Status)">
                                        @GetStatusText(appointment.Status)
                                    </span>
                                </div>
                            </div>
                            <div class="card-body">
                                <p>
                                    <i class="fa fa-clock"></i>
                                    <strong>Thời gian:</strong>
                                    <span>@appointment.AppointmentTime?.ToString("dd/MM/yyyy HH:mm")</span>
                                </p>
                                <p>
                                    <i class="fa fa-map-marker"></i>
                                    <strong>Địa điểm:</strong>
                                    <span>@appointment.Garage?.Address</span>
                                </p>
                                
                                @if (details.Any())
                                {
                                    <p>
                                        <i class="fa fa-cogs"></i>
                                        <strong>Dịch vụ:</strong>
                                    </p>
                                    <ul class="list-unstyled">
                                        @foreach (var detail in details)
                                        {
                                            <li>
                                                <i class="fa fa-check"></i>
                                                @detail.Service?.ServiceName
                                            </li>
                                        }
                                    </ul>
                                    <p>
                                        <i class="fa fa-money"></i>
                                        <strong>Tổng tiền:</strong>
                                        @if (discountAmount > 0)
                                        {
                                            <span class="text-decoration-line-through">@totalServicePrice.ToString("N0")</span>
                                            <span class="text-success">@totalAmount.ToString("N0") VNĐ</span>
                                            <small class="text-success">(-@discountAmount.ToString("N0") VNĐ)</small>
                                        }
                                        else
                                        {
                                            <span>@totalAmount.ToString("N0") VNĐ</span>
                                        }
                                    </p>
                                }

                                @if (!string.IsNullOrEmpty(appointment.Notes))
                                {
                                    <p>
                                        <i class="fa fa-sticky-note"></i>
                                        <strong>Ghi chú:</strong>
                                        <span>@appointment.Notes</span>
                                    </p>
                                }
                            </div>
                            <div class="card-footer">
                                <div class="d-flex justify-content-between">
                                    <a asp-action="Details" asp-route-id="@appointment.AppointmentId" class="btn btn-primary">
                                        <i class="fa fa-eye"></i> Chi tiết
                                    </a>
                                    
                                    @if (appointment.Status == "Pending")
                                    {
                                        var payments = ViewBag.Payments as List<PaymentHistory>;
                                        var payment = payments?.FirstOrDefault(p => p.AppointmentId == appointment.AppointmentId);
                                        if (payment != null && payment.Status == "Success")
                                        {
                                            <span class="text-success">
                                                <i class="fa fa-check-circle"></i> Đã thanh toán
                                            </span>
                                        }
                                        else
                                        {
                                            <form method="post" action="/payment/create" style="display:inline;">
                                                <input type="hidden" name="amount" value="@totalAmount" />
                                                <input type="hidden" name="description" value="Thanh toán lịch hẹn #@appointment.AppointmentId - @appointment.User?.FullName@(discountAmount > 0 ? $" (Đã giảm {discountAmount:N0} VNĐ)" : "")" />
                                                <input type="hidden" name="appointmentId" value="@appointment.AppointmentId" />
                                                <button type="submit" class="btn btn-success">
                                                    <i class="fa fa-credit-card"></i> Thanh toán
                                                </button>
                                            </form>
                                        }
                                    }
                                    else if (appointment.Status == "Confirmed")
                                    {
                                        <span class="text-success">
                                            <i class="fa fa-check-circle"></i> Đã xác nhận
                                        </span>
                                    }
                                    else if (appointment.Status == "In Progress" || appointment.Status == "In_Progress")
                                    {
                                        <span class="text-info">
                                            <i class="fa fa-cogs"></i> Đang thực hiện
                                        </span>
                                    }
                                    else if (appointment.Status == "Completed")
                                    {
                                        <span class="text-info">
                                            <i class="fa fa-flag-checkered"></i> Hoàn thành
                                        </span>
                                    }
                                </div>
                            </div>
                        </div>
                    </div>
                }
            </div>
        }
    </div>
</section>

@functions {
    private string GetStatusBadgeClass(string? status)
    {
        return status switch
        {
            "Pending" => "bg-warning",
            "Confirmed" => "bg-success",
            "In Progress" => "bg-info",
            "In_Progress" => "bg-info",
            "Completed" => "bg-primary",
            "Cancelled" => "bg-danger",
            _ => "bg-secondary"
        };
    }

    private string GetStatusText(string? status)
    {
        return status switch
        {
            "Pending" => "Chờ xử lý",
            "Confirmed" => "Đã xác nhận",
            "In Progress" => "Đang thực hiện",
            "In_Progress" => "Đang thực hiện",
            "Completed" => "Hoàn thành",
            "Cancelled" => "Đã hủy",
            _ => "Không xác định"
        };
    }
}

<!-- FontAwesome -->
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/4.7.0/css/font-awesome.min.css" /> 