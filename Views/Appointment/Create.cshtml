@model test_2.Models.AppointmentViewModel

@{
    ViewData["Title"] = "Đặt lịch hẹn";
}

<h2>Đặt lịch hẹn</h2>

<form asp-action="Create" method="post">
    @Html.ValidationSummary(true, "", new { @class = "text-danger" })

    <div class="form-group">
        <label asp-for="CustomerName"></label>
        <input asp-for="CustomerName" class="form-control" />
        <span asp-validation-for="CustomerName" class="text-danger"></span>
    </div>

    <div class="form-group">
        <label asp-for="Phone"></label>
        <input asp-for="Phone" class="form-control" />
        <span asp-validation-for="Phone" class="text-danger"></span>
    </div>

    <div class="form-group">
        <label asp-for="ServiceId">Dịch vụ</label>
        <select asp-for="ServiceId" asp-items="Model.ServiceList" class="form-control">
            <option value="">-- Chọn dịch vụ --</option>
        </select>
        <span asp-validation-for="ServiceId" class="text-danger"></span>
    </div>

    <div class="form-group">
        <label asp-for="GarageId">Chọn Garage</label>
        <select asp-for="GarageId" asp-items="Model.GarageList" class="form-control">
            <option value="">-- Chọn garage --</option>
        </select>
        <span asp-validation-for="GarageId" class="text-danger"></span>
    </div>

    <div class="form-group">
        <label asp-for="AppointmentTime">Thời gian hẹn</label>
        <input asp-for="AppointmentTime" type="datetime-local" class="form-control" />
        <span asp-validation-for="AppointmentTime" class="text-danger"></span>
    </div>

    <div class="form-group">
        <label asp-for="Notes">Ghi chú</label>
        <textarea asp-for="Notes" class="form-control"></textarea>
        <span asp-validation-for="Notes" class="text-danger"></span>
    </div>

    <button type="submit" class="btn btn-primary">Đặt lịch</button>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
