@model test_2.Models.AppointmentEditViewModel
@inject Microsoft.AspNetCore.Http.IHttpContextAccessor HttpContextAccessor

@{
    ViewData["Title"] = "Sửa lịch hẹn";
    var fullname = HttpContextAccessor.HttpContext.Session.GetString("FullName") ?? "";
    var phone = HttpContextAccessor.HttpContext.Session.GetString("Phone") ?? "";
}
<style>
    body { background-color: #EBE7DE; color: #152A16; }
    .appointment-container { background-color: #fff; border-radius: 12px; padding: 40px 30px; max-width: 700px; margin: 50px auto; box-shadow: 0 4px 20px rgba(0,0,0,0.1); }
    h2 { color: #152A16; text-align: center; margin-bottom: 25px; font-weight: bold; }
    label { color: #152A16; font-weight: 600; }
    .form-control, select, textarea { background-color: #f8f8f8; border: 1px solid #ccc; color: #152A16; border-radius: 6px; }
    .form-control:focus { background-color: #fff; border-color: #152A16; box-shadow: 0 0 0 0.2rem rgba(21, 42, 22, 0.15); }
    .text-danger { color: #C0392B !important; }
    .btn-custom { background-color: #152A16; color: #fff; font-weight: bold; border-radius: 8px; padding: 10px 25px; transition: 0.3s ease; }
    .btn-custom:hover { background-color: #0F1F10; color: #fff; }
    .user-info { font-size: 0.95rem; margin-bottom: 20px; background-color: #f3f3f3; padding: 12px 20px; border-radius: 8px; }
    .user-info strong { color: #152A16; }
    .form-group { margin-bottom: 15px; }
</style>
<div class="appointment-container">
    <h2>Sửa lịch hẹn</h2>
    <div class="user-info">
        <p><strong>Họ tên:</strong> @fullname</p>
        <p><strong>SĐT:</strong> @phone</p>
    </div>
    <form asp-action="Edit" method="post">
        @Html.HiddenFor(m => m.AppointmentId)
        @Html.ValidationSummary(true, "", new { @class = "text-danger" })
        <div class="form-group">
            <label asp-for="VehicleMake">Hãng xe</label>
            <input asp-for="VehicleMake" class="form-control" />
            <span asp-validation-for="VehicleMake" class="text-danger"></span>
        </div>
        <div class="form-group">
            <label asp-for="VehicleModel">Dòng xe</label>
            <input asp-for="VehicleModel" class="form-control" />
            <span asp-validation-for="VehicleModel" class="text-danger"></span>
        </div>
        <div class="form-group">
            <label asp-for="LicensePlate">Biển số</label>
            <input asp-for="LicensePlate" class="form-control" placeholder="VD: 30A-12345" />
            <span asp-validation-for="LicensePlate" class="text-danger"></span>
        </div>
        <div class="form-group">
            <label asp-for="GarageId">Garage</label>
            <select asp-for="GarageId" asp-items="Model.GarageList" class="form-control">
                <option value="">-- Chọn garage --</option>
            </select>
            <span asp-validation-for="GarageId" class="text-danger"></span>
        </div>
        <div class="form-group">
            <label asp-for="AppointmentTime">Thời gian hẹn</label>
            <input asp-for="AppointmentTime" type="datetime-local" class="form-control" id="appointmentTime" />
            <span asp-validation-for="AppointmentTime" class="text-danger"></span>
        </div>
        <div class="form-group">
            <label asp-for="Notes">Ghi chú</label>
            <textarea asp-for="Notes" class="form-control"></textarea>
            <span asp-validation-for="Notes" class="text-danger"></span>
        </div>
        <div class="text-center mt-4">
            <button type="submit" class="btn btn-custom">Lưu thay đổi</button>
        </div>
    </form>
</div>
@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
