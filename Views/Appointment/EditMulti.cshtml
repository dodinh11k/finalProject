@model test_2.Models.MultiVehicleAppointmentViewModel
@inject Microsoft.AspNetCore.Http.IHttpContextAccessor HttpContextAccessor

@{
    var username = HttpContextAccessor.HttpContext.Session.GetString("Username") ?? "";
    var fullname = HttpContextAccessor.HttpContext.Session.GetString("FullName") ?? "";
    var phone = HttpContextAccessor.HttpContext.Session.GetString("Phone") ?? "";
    ViewData["Title"] = "Sửa lịch nhiều xe";
    var oldServiceData = new System.Text.Json.JsonSerializerOptions();
    var oldServices = new List<object>();
    decimal oldTotal = 0;
    foreach (var v in Model.Vehicles)
    {
        var serviceIds = v.ServiceIds ?? new List<int>();
        oldServices.Add(new { ServiceIds = serviceIds });
        foreach (var sid in serviceIds)
        {
            var service = Model.ServiceList.FirstOrDefault(s => s.Value == sid.ToString());
            if (service != null && decimal.TryParse(service.Text.Split('-').LastOrDefault()?.Replace("VNĐ", "").Replace(",", "").Trim(), out var price))
            {
                oldTotal += price;
            }
        }
    }
    var oldServiceJson = System.Text.Json.JsonSerializer.Serialize(new { OldServices = oldServices, OldTotal = oldTotal });
    var oldServiceIdsList = Model.Vehicles.Select(v => v.ServiceIds ?? new List<int>()).ToList();
    var oldServiceIdsJson = System.Text.Json.JsonSerializer.Serialize(oldServiceIdsList);
    // Parse lại để dùng khi render checkbox
    var oldServiceIdsParsed = System.Text.Json.JsonSerializer.Deserialize<List<List<int>>>(oldServiceIdsJson);
}
<input type="hidden" name="OldServiceData" value='@oldServiceJson' />
<input type="hidden" name="OldServiceIdsJson" value='@oldServiceIdsJson' />

<style>
    body { background-color: #EBE7DE; 
        color: #152A16; }
    .appointment-container { background-color: #fff; 
        border-radius: 12px; padding: 40px 30px; max-width: 900px; 
        margin: 50px auto;
        box-shadow: 0 4px 20px rgba(0,0,0,0.1); }
    h2 { color: #152A16; text-align: center;
        margin-bottom: 25px; font-weight: bold; }
    label { color: #152A16; font-weight: 600; }
    .form-control, select, textarea { background-color: #f8f8f8; 
        border: 1px solid #ccc; color: #152A16; border-radius: 6px; }
    .form-control:focus { background-color: #fff; 
        border-color: #152A16; 
        box-shadow: 0 0 0 0.2rem rgba(21, 42, 22, 0.15); }
    .text-danger { color: #C0392B !important; }
    .btn-custom { background-color: #152A16; 
        color: #fff;
        font-weight: bold; 
        border-radius: 8px; 
        padding: 10px 25px; 
        transition: 0.3s ease; }
    .btn-custom:hover { background-color: #0F1F10; 
        color: #fff; }
    .btn-secondary { background-color: #6c757d;
        color: #fff; font-weight: bold; 
        border-radius: 8px; padding: 10px 25px; 
        transition: 0.3s ease; }
    .btn-secondary:hover { background-color: #5a6268; 
        color: #fff; }
    .user-info { font-size: 0.95rem; margin-bottom: 20px;
        background-color: #f3f3f3; padding: 12px 20px; 
        border-radius: 8px; }
    .user-info strong { color: #152A16; }
    .form-group { margin-bottom: 15px; }
    .vehicle-section { background-color: #f8f9fa; border: 2px solid #e9ecef;
        border-radius: 8px; padding: 20px; margin-bottom: 20px; position: relative; }
    .vehicle-header { display: flex; justify-content: space-between; align-items: center; 
        margin-bottom: 15px; padding-bottom: 10px; border-bottom: 1px solid #dee2e6; }
    .vehicle-title { font-weight: bold; color: #152A16; font-size: 1.1rem; }
    .remove-vehicle { background-color: #dc3545; color: white; border: none;
        border-radius: 50%; width: 30px; height: 30px; font-size: 16px; 
        cursor: pointer; transition: 0.3s ease; }
    .remove-vehicle:hover { background-color: #c82333; }
    .add-vehicle-btn { background-color: #28a745; color: white; 
        border: none; border-radius: 8px; padding: 10px 20px; 
        font-weight: bold; cursor: pointer; transition: 0.3s ease; 
        margin-bottom: 20px; }
    .add-vehicle-btn:hover { background-color: #218838; }
    .service-checkboxes { display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 10px; margin-top: 10px; }
    .form-check { margin-bottom: 8px; }
    .vehicle-type-toggle { margin-bottom: 15px; }
    .vehicle-type-toggle label { margin-right: 15px; cursor: pointer; }
    .vehicle-type-toggle input[type="radio"] { margin-right: 5px; }
    .vehicle-fields { display: none; }
    .vehicle-fields.show { display: block; }
    .existing-vehicle-select { display: none; }
    .existing-vehicle-select.show { display: block; }
    .time-selector { background-color: #f8f9fa; border: 1px solid #e9ecef; border-radius: 12px; padding: 25px; margin-bottom: 20px; }
    .time-selector .row { margin: 0; align-items: center; }
    .time-selector .col-md-2 { padding: 0 8px; margin-bottom: 10px; }
    .time-selector select { font-size: 1.1rem !important; padding: 12px 15px !important; height: auto !important; min-height: 50px !important; border: 2px solid #dee2e6 !important; border-radius: 8px !important; background-color: #fff !important; color: #152A16 !important; font-weight: 500 !important; cursor: pointer !important; transition: all 0.3s ease !important; }
    .time-selector select:focus { border-color: #152A16 !important; box-shadow: 0 0 0 0.2rem rgba(21, 42, 22, 0.15) !important; outline: none !important; }
    .time-selector select:hover { border-color: #152A16 !important; background-color: #f8f9fa !important; }
    .time-selector .col-md-2::before { content: attr(data-label); display: block; font-size: 0.85rem; font-weight: 600; color: #152A16; margin-bottom: 8px; text-align: center; }
    .time-display { background-color: #e9ecef; border-radius: 10px; padding: 15px 20px; margin-top: 15px; font-weight: 600; font-size: 1.1rem; text-align: center; border: 2px solid #dee2e6; transition: all 0.3s ease; }
    .time-display.valid { background-color: #d4edda; color: #155724; border: 2px solid #c3e6cb; box-shadow: 0 2px 8px rgba(40, 167, 69, 0.2); }
    .time-display.invalid { background-color: #f8d7da; color: #721c24; border: 2px solid #f5c6cb; box-shadow: 0 2px 8px rgba(220, 53, 69, 0.2); }
    @@media (max-width: 768px) { .time-selector .col-md-2 { margin-bottom: 15px; } .time-selector select { font-size: 1rem !important; padding: 10px 12px !important; min-height: 45px !important; } .time-display { font-size: 1rem; padding: 12px 15px; } }
</style>

<div class="appointment-container">
    <h2>Sửa lịch nhiều xe</h2>
    <div class="user-info">
        <p><strong>Họ tên:</strong> @(string.IsNullOrEmpty(fullname) ? "Không có" : fullname)</p>
        <p><strong>Số điện thoại:</strong> @(string.IsNullOrEmpty(phone) ? "Không có" : phone)</p>
    </div>
    <form asp-action="EditMulti" method="post" id="multiVehicleForm">
        <input type="hidden" name="id" value="@Context.Request.Query["id"]" />
        @Html.ValidationSummary(true, "", new { @class = "text-danger" })
        <div class="form-group">
            <label asp-for="GarageId">Garage</label>
            <select asp-for="GarageId" asp-items="Model.GarageList" class="form-control">
                <option value="">-- Chọn garage --</option>
            </select>
            <span asp-validation-for="GarageId" class="text-danger"></span>
        </div>
        <div class="form-group">
            <label asp-for="AppointmentTime">Thời gian hẹn</label>
            <div class="time-selector">
                <div class="row">
                    <div class="col-md-2" data-label="Giờ">
                        <select id="appointmentHour" class="form-control" onchange="updateDateTime()">
                            <option value="">--</option>
                            @for (int i = 1; i <= 12; i++)
                            {
                                <option value="@i.ToString("00")">@i</option>
                            }
                        </select>
                    </div>
                    <div class="col-md-2" data-label="Phút">
                        <select id="appointmentMinute" class="form-control" onchange="updateDateTime()">
                            <option value="">--</option>
                            @for (int i = 0; i <= 59; i += 5)
                            {
                                <option value="@i.ToString("00")">@i.ToString("00")</option>
                            }
                        </select>
                    </div>
                    <div class="col-md-2" data-label="AM/PM">
                        <select id="appointmentPeriod" class="form-control" onchange="updateDateTime()">
                            <option value="">--</option>
                            <option value="AM">Sáng (AM)</option>
                            <option value="PM">Chiều (PM)</option>
                        </select>
                    </div>
                    <div class="col-md-2" data-label="Ngày">
                        <select id="appointmentDay" class="form-control" onchange="updateDateTime()">
                            <option value="">--</option>
                            @for (int i = 1; i <= 31; i++)
                            {
                                <option value="@i.ToString("00")">@i</option>
                            }
                        </select>
                    </div>
                    <div class="col-md-2" data-label="Tháng">
                        <select id="appointmentMonth" class="form-control" onchange="updateDateTime()">
                            <option value="">--</option>
                            @{
                                var months = new[] { "01", "02", "03", "04", "05", "06", "07", "08", "09", "10", "11", "12" };
                                var monthNames = new[] { "T1", "T2", "T3", "T4", "T5", "T6", "T7", "T8", "T9", "T10", "T11", "T12" };
                            }
                            @for (int i = 0; i < months.Length; i++)
                            {
                                <option value="@months[i]">@monthNames[i]</option>
                            }
                        </select>
                    </div>
                    <div class="col-md-2" data-label="Năm">
                        <select id="appointmentYear" class="form-control" onchange="updateDateTime()">
                            <option value="">--</option>
                            @for (int i = DateTime.Now.Year; i <= DateTime.Now.Year + 2; i++)
                            {
                                <option value="@i">@i</option>
                            }
                        </select>
                    </div>
                </div>
            </div>
            <input asp-for="AppointmentTime" type="datetime-local" id="appointmentTime" style="display:none;" />
            <div class="time-display">
                <strong>Thời gian đã chọn:</strong> <span id="selectedDateTime">Chưa chọn</span>
            </div>
            <span asp-validation-for="AppointmentTime" class="text-danger"></span>
        </div>
        <div class="form-group">
            <label asp-for="PromoCode">Mã khuyến mãi</label>
            <input asp-for="PromoCode" class="form-control" id="promoCode" placeholder="Nhập mã khuyến mãi (nếu có)" onblur="validateVoucher()" />
            <span asp-validation-for="PromoCode" class="text-danger"></span>
            <div id="voucherMessage" class="mt-2"></div>
        </div>
        <div class="form-group">
            <label asp-for="Notes">Ghi chú chung</label>
            <textarea asp-for="Notes" class="form-control" rows="3"></textarea>
            <span asp-validation-for="Notes" class="text-danger"></span>
        </div>
        <button type="button" class="add-vehicle-btn" onclick="addVehicle()">
            <i class="fas fa-plus"></i> Thêm xe
        </button>
        <div id="vehiclesContainer">
            @for (int i = 0; i < Model.Vehicles.Count; i++)
            {
                <div class="vehicle-section" data-vehicle-index="@i">
                    <div class="vehicle-header">
                        <span class="vehicle-title">Xe @(i + 1)</span>
                        @if (Model.Vehicles.Count > 1)
                        {
                            <button type="button" class="remove-vehicle" onclick="removeVehicle(@i)">×</button>
                        }
                    </div>
                    <div class="vehicle-type-toggle">
                        <label>
                            <input type="radio" name="Vehicles[@i].VehicleType" value="new" checked onchange="toggleVehicleType(@i, 'new')" />
                            Thêm xe mới
                        </label>
                        <label>
                            <input type="radio" name="Vehicles[@i].VehicleType" value="existing" onchange="toggleVehicleType(@i, 'existing')" />
                            Chọn xe có sẵn
                        </label>
                    </div>
                    <div class="vehicle-fields show" id="newVehicleFields_@i">
                        <div class="form-group">
                            <label>Hãng xe</label>
                            <select name="Vehicles[@i].VehicleMake" class="form-control vehicle-make-select" data-vehicle-index="@i" onchange="loadVehicleModels(@i)">
                                <option value="">-- Chọn hãng xe --</option>
                                @foreach (var make in Model.VehicleMakeList)
                                {
                                    if (Model.Vehicles[i].VehicleMake == make.Value)
                                    {
                                        <option value="@make.Value" selected="selected">@make.Text</option>
                                    }
                                    else
                                    {
                                        <option value="@make.Value">@make.Text</option>
                                    }
                                }
                            </select>
                        </div>
                        <div class="form-group">
                            <label>Dòng xe</label>
                            <select name="Vehicles[@i].VehicleModel" class="form-control vehicle-model-select" id="vehicleModel_@i" @(string.IsNullOrEmpty(Model.Vehicles[i].VehicleModel) ? "disabled" : "")>
                                <option value="">-- Chọn dòng xe --</option>
                                @if (!string.IsNullOrEmpty(Model.Vehicles[i].VehicleMake))
                                {
                                    var models = test_2.Models.VehicleData.GetVehicleModelList(Model.Vehicles[i].VehicleMake);
                                    foreach (var vehicleModel in models)
                                    {
                                        if (Model.Vehicles[i].VehicleModel == vehicleModel.Value)
                                        {
                                            <option value="@vehicleModel.Value" selected="selected">@vehicleModel.Text</option>
                                        }
                                        else
                                        {
                                            <option value="@vehicleModel.Value">@vehicleModel.Text</option>
                                        }
                                    }
                                }
                            </select>
                        </div>
                        <div class="form-group">
                            <label>Biển số</label>
                            <input name="Vehicles[@i].LicensePlate" class="form-control" placeholder="VD: 30A-12345" value="@Model.Vehicles[i].LicensePlate" />
                        </div>
                    </div>
                    <div class="existing-vehicle-select" id="existingVehicleSelect_@i">
                        <div class="form-group">
                            <label>Chọn xe có sẵn</label>
                            <select name="Vehicles[@i].SelectedVehicleId" class="form-control">
                                <option value="">-- Chọn xe --</option>
                                @foreach (var vehicle in Model.VehicleList)
                                {
                                    if (Model.Vehicles[i].SelectedVehicleId.HasValue && Model.Vehicles[i].SelectedVehicleId.Value.ToString() == vehicle.Value)
                                    {
                                        <option value="@vehicle.Value" selected="selected">@vehicle.Text</option>
                                    }
                                    else
                                    {
                                        <option value="@vehicle.Value">@vehicle.Text</option>
                                    }
                                }
                            </select>
                        </div>
                    </div>
                    <div class="form-group">
                        <label>Ghi chú cho xe này</label>
                        <textarea name="Vehicles[@i].VehicleNotes" class="form-control" rows="2">@Model.Vehicles[i].VehicleNotes</textarea>
                    </div>
                </div>
            }
        </div>
        <div class="text-center mt-4">
            <button type="submit" class="btn btn-custom">Lưu thay đổi</button>
            <a href="@Url.Action("Create", "Appointment")" class="btn btn-secondary">Đặt lịch 1 xe</a>
        </div>
    </form>
</div>
<script>
    // ... giữ nguyên toàn bộ script như CreateMulti.cshtml ...
    document.addEventListener('DOMContentLoaded', function() {
        // Nếu có giá trị AppointmentTime từ model, set lại các dropdown
        var apptTime = '@Model.AppointmentTime.ToString("yyyy-MM-ddTHH:mm")';
        if (apptTime && apptTime !== "0001-01-01T00:00") {
            var dt = new Date(apptTime);
            document.getElementById('appointmentHour').value = (dt.getHours() % 12 === 0 ? 12 : dt.getHours() % 12).toString().padStart(2, '0');
            document.getElementById('appointmentMinute').value = dt.getMinutes().toString().padStart(2, '0');
            document.getElementById('appointmentPeriod').value = dt.getHours() >= 12 ? 'PM' : 'AM';
            document.getElementById('appointmentDay').value = dt.getDate().toString().padStart(2, '0');
            document.getElementById('appointmentMonth').value = (dt.getMonth() + 1).toString().padStart(2, '0');
            document.getElementById('appointmentYear').value = dt.getFullYear();
            updateDateTime();
        } else {
            setDefaultDateTime();
        }
    });

    document.getElementById('multiVehicleForm').addEventListener('submit', function(e) {
        updateDateTime(); // Đảm bảo luôn cập nhật lại input hidden trước khi submit
    });

    function updateDateTime() {
        const hour = document.getElementById('appointmentHour').value;
        const minute = document.getElementById('appointmentMinute').value;
        const period = document.getElementById('appointmentPeriod').value;
        const day = document.getElementById('appointmentDay').value;
        const month = document.getElementById('appointmentMonth').value;
        const year = document.getElementById('appointmentYear').value;
        if (hour && minute && period && day && month && year) {
            let hour24 = parseInt(hour);
            if (period === 'PM' && hour24 !== 12) {
                hour24 += 12;
            } else if (period === 'AM' && hour24 === 12) {
                hour24 = 0;
            }
            const selectedDate = new Date(year, month - 1, day, hour24, minute);
            // Format cho input type=datetime-local: yyyy-MM-ddTHH:mm
            const yyyy = selectedDate.getFullYear();
            const MM = (selectedDate.getMonth() + 1).toString().padStart(2, '0');
            const dd = selectedDate.getDate().toString().padStart(2, '0');
            const HH = selectedDate.getHours().toString().padStart(2, '0');
            const mm = selectedDate.getMinutes().toString().padStart(2, '0');
            document.getElementById('appointmentTime').value = `${yyyy}-${MM}-${dd}T${HH}:${mm}`;
            // ... giữ nguyên hiển thị ...
        } else {
            document.getElementById('appointmentTime').value = '';
        }
    }
</script> 