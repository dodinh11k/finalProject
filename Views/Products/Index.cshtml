@model IEnumerable<test_2.Models.Product>

@{
    ViewData["Title"] = "Sản phẩm của chúng tôi";
}

<style>
    .products-hero {
        background: linear-gradient(135deg, #28a745 0%, #20c997 50%, #17a2b8 100%);
        padding: 80px 0;
        margin-top: 80px;
        color: white;
        text-align: center;
        position: relative;
        overflow: hidden;
    }

    .products-hero::before {
        content: '';
        position: absolute;
        top: 0;
        left: 0;
        right: 0;
        bottom: 0;
        background: url('data:image/svg+xml,<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 100 100"><defs><pattern id="grain" width="100" height="100" patternUnits="userSpaceOnUse"><circle cx="50" cy="50" r="1" fill="white" opacity="0.1"/></pattern></defs><rect width="100" height="100" fill="url(%23grain)"/></svg>');
        opacity: 0.2;
    }

    .products-hero h1 {
        font-size: 3.2rem;
        font-weight: 800;
        margin-bottom: 20px;
        position: relative;
        z-index: 2;
        text-shadow: 2px 2px 4px rgba(0,0,0,0.3);
    }

    .products-hero p {
        font-size: 1.3rem;
        opacity: 0.95;
        position: relative;
        z-index: 2;
        font-weight: 300;
        max-width: 600px;
        margin: 0 auto;
    }

    .products-section {
        padding: 80px 0;
        background: #f8f9fa;
    }

    .products-container {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
        gap: 30px;
        padding: 0 20px;
        max-width: 1200px;
        margin: 0 auto;
    }

    .product-card {
        background: white;
        border-radius: 20px;
        box-shadow: 0 10px 30px rgba(0,0,0,0.1);
        overflow: hidden;
        transition: all 0.3s ease;
        position: relative;
        border: none;
        cursor: pointer;
    }

    .product-card::before {
        content: '';
        position: absolute;
        top: 0;
        left: 0;
        right: 0;
        height: 4px;
        background: linear-gradient(90deg, #28a745, #20c997);
    }

    .product-card:hover {
        transform: translateY(-10px);
        box-shadow: 0 20px 40px rgba(0,0,0,0.15);
    }

    .product-card img {
        width: 100%;
        height: 200px;
        object-fit: cover;
        transition: transform 0.3s ease;
    }

    .product-card:hover img {
        transform: scale(1.05);
    }

    .product-card-body {
        padding: 25px;
        color: #2c3e50;
    }

    .product-card-title {
        font-size: 1.2rem;
        font-weight: 700;
        margin-bottom: 10px;
        color: #2c3e50;
        line-height: 1.3;
    }

    .product-description {
        color: #6c757d;
        font-size: 0.9rem;
        line-height: 1.5;
        margin-bottom: 15px;
        display: -webkit-box;
        -webkit-line-clamp: 2;
        -webkit-box-orient: vertical;
        overflow: hidden;
    }

    .product-price {
        font-size: 1.3rem;
        font-weight: 700;
        color: #28a745;
        margin-bottom: 10px;
    }

    .product-stock {
        font-size: 0.85rem;
        color: #6c757d;
        margin-bottom: 20px;
        font-weight: 500;
    }

    .product-actions {
        display: flex;
        flex-direction: column;
        gap: 10px;
    }

    .btn-buy-now {
        background: linear-gradient(135deg, #28a745 0%, #20c997 100%);
        color: white;
        border: none;
        padding: 12px 20px;
        border-radius: 8px;
        font-weight: 600;
        text-decoration: none;
        transition: all 0.3s ease;
        text-align: center;
        font-size: 0.9rem;
    }

    .btn-buy-now:hover {
        transform: translateY(-2px);
        box-shadow: 0 5px 15px rgba(40, 167, 69, 0.3);
        color: white;
    }

    .btn-add-cart {
        background: #6c757d;
        color: white;
        border: none;
        padding: 10px 20px;
        border-radius: 8px;
        font-weight: 600;
        text-decoration: none;
        transition: all 0.3s ease;
        text-align: center;
        font-size: 0.9rem;
    }

    .btn-add-cart:hover {
        background: #5a6268;
        color: white;
        transform: translateY(-1px);
    }

    .btn-favorite {
        background: transparent;
        color: #dc3545;
        border: 2px solid #dc3545;
        padding: 8px 20px;
        border-radius: 8px;
        font-weight: 600;
        text-decoration: none;
        transition: all 0.3s ease;
        text-align: center;
        font-size: 0.85rem;
    }

    .btn-favorite:hover {
        background: #dc3545;
        color: white;
        transform: translateY(-1px);
    }

    .no-products {
        text-align: center;
        padding: 80px 20px;
        font-size: 1.3rem;
        color: #6c757d;
        background: white;
        border-radius: 20px;
        box-shadow: 0 10px 30px rgba(0,0,0,0.1);
        margin: 40px auto;
        max-width: 500px;
    }

    .floating-shapes {
        position: absolute;
        width: 100%;
        height: 100%;
        overflow: hidden;
        z-index: 1;
    }

    .shape {
        position: absolute;
        background: rgba(255,255,255,0.1);
        border-radius: 50%;
        animation: float 6s ease-in-out infinite;
    }

    .shape:nth-child(1) {
        width: 80px;
        height: 80px;
        top: 20%;
        left: 10%;
        animation-delay: 0s;
    }

    .shape:nth-child(2) {
        width: 60px;
        height: 60px;
        top: 60%;
        right: 10%;
        animation-delay: 2s;
    }

    .shape:nth-child(3) {
        width: 40px;
        height: 40px;
        top: 40%;
        left: 50%;
        animation-delay: 4s;
    }

    @@keyframes float {
        0%, 100% { transform: translateY(0px) rotate(0deg); }
        50% { transform: translateY(-20px) rotate(180deg); }
    }

    .stats-section {
        background: white;
        padding: 40px 0;
        margin-top: 40px;
    }

    .stats-container {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
        gap: 30px;
        max-width: 1200px;
        margin: 0 auto;
        padding: 0 20px;
    }

    .stat-card {
        text-align: center;
        padding: 30px 20px;
        background: linear-gradient(135deg, #f8f9fa 0%, #e9ecef 100%);
        border-radius: 15px;
        box-shadow: 0 5px 15px rgba(0,0,0,0.1);
    }

    .stat-number {
        font-size: 2.5rem;
        font-weight: 700;
        color: #28a745;
        margin-bottom: 10px;
    }

    .stat-label {
        color: #6c757d;
        font-size: 0.9rem;
        text-transform: uppercase;
        letter-spacing: 1px;
        font-weight: 600;
    }

    .alert {
        border-radius: 12px;
        border: none;
        padding: 15px 20px;
        margin-bottom: 30px;
        max-width: 800px;
        margin-left: auto;
        margin-right: auto;
    }

    .alert-success {
        background: linear-gradient(135deg, #28a745 0%, #20c997 100%);
        color: white;
    }

    .alert-info {
        background: linear-gradient(135deg, #17a2b8 0%, #20c997 100%);
        color: white;
    }
</style>

<!-- Hero Section -->
<section class="products-hero">
    <div class="floating-shapes">
        <div class="shape"></div>
        <div class="shape"></div>
        <div class="shape"></div>
    </div>
    <div class="container">
        <h1>Sản phẩm của chúng tôi</h1>
        <p>Khám phá bộ sưu tập phụ tùng và phụ kiện xe chất lượng cao</p>
    </div>
</section>

<!-- Products Section -->
<section class="products-section">
    <div class="container">
        @if (TempData["success"] != null)
        {
            <div class="alert alert-success">
                <i class="fa fa-check-circle me-2"></i>
                @TempData["success"]
            </div>
        }
        @if (TempData["info"] != null)
        {
            <div class="alert alert-info">
                <i class="fa fa-info-circle me-2"></i>
                @TempData["info"]
            </div>
        }

        @if (Model == null || !Model.Any())
        {
            <div class="no-products">
                <i class="fa fa-box-open me-2"></i>
                Hiện tại chưa có sản phẩm nào.
            </div>
        }
        else
        {
            <div class="products-container">
                @foreach (var product in Model)
                {
                    <div class="product-card" onclick="window.location.href='@Url.Action("Details", "Products", new { id = product.ProductId })'">
                        <img src="@Url.Content("~/" + product.ImageUrl)" alt="@product.ProductName" />
                        <div class="product-card-body">
                            <div class="product-card-title">@product.ProductName</div>
                            <div class="product-description">@product.Description</div>
                            <div class="product-price">@product.Price.ToString("N0") VNĐ</div>
                            <div class="product-stock">Còn lại: @product.StockQuantity</div>
                            
                            <div class="product-actions">
                                <form asp-controller="Order" asp-action="BuyNow" method="post" style="margin: 0;">
                                    <input type="hidden" name="productId" value="@product.ProductId" />
                                    <input type="hidden" name="quantity" value="1" />
                                    <button type="submit" class="btn-buy-now w-100">
                                        <i class="fa fa-bolt me-1"></i>Mua ngay
                                    </button>
                                </form>
                                
                                <form asp-controller="Cart" asp-action="AddToCart" method="post" style="margin: 0;">
                                    <input type="hidden" name="productId" value="@product.ProductId" />
                                    <input type="hidden" name="quantity" value="1" />
                                    <button type="submit" class="btn-add-cart w-100">
                                        <i class="fa fa-shopping-cart me-1"></i>Thêm vào giỏ
                                    </button>
                                </form>
                                
                                <form asp-controller="Favorites" asp-action="AddFavorite" method="post" style="margin: 0;">
                                    <input type="hidden" name="productId" value="@product.ProductId" />
                                    <button type="submit" class="btn-favorite w-100">
                                        <i class="fa fa-heart me-1"></i>Yêu thích
                                    </button>
                                </form>
                            </div>
                        </div>
                    </div>
                }
            </div>
        }
    </div>
</section>

<!-- Stats Section -->
<section class="stats-section">
    <div class="stats-container">
        <div class="stat-card">
            <div class="stat-number">@Model?.Count()</div>
            <div class="stat-label">Sản phẩm</div>
        </div>
        <div class="stat-card">
            <div class="stat-number">100%</div>
            <div class="stat-label">Chính hãng</div>
        </div>
        <div class="stat-card">
            <div class="stat-number">24/7</div>
            <div class="stat-label">Hỗ trợ</div>
        </div>
        <div class="stat-card">
            <div class="stat-number">Free</div>
            <div class="stat-label">Vận chuyển</div>
        </div>
    </div>
</section>

<!-- FontAwesome -->
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/4.7.0/css/font-awesome.min.css" />
