@model IEnumerable<test_2.Models.Product>

@{
    ViewData["Title"] = "Danh sách sản phẩm";
}

<style>
    body {
        background-color: #EBE7DE;
        color: #152A16;
    }

    h2 {
        color: #152A16;
        font-weight: bold;
        text-align: center;
        margin-bottom: 20px;
        margin-top: 30px;
    }

    .product-card {
        background-color: #fff;
        border-radius: 12px;
        overflow: hidden;
        box-shadow: 0 3px 10px rgba(0, 0, 0, 0.1);
        transition: transform 0.3s ease, box-shadow 0.3s ease;
        height: 95%;
        display: flex;
        flex-direction: column;
        justify-content: space-between;
        margin-bottom: 10px;
    }

        .product-card:hover {
            transform: translateY(-5px);
            box-shadow: 0 6px 16px rgba(0, 0, 0, 0.15);
        }

    .card-img-top {
        height: 160px;
        object-fit: cover;
    }

    .product-title {
        font-weight: bold;
        color: #152A16;
        font-size: 1rem;
        margin-bottom: 4px;
    }

    .product-description {
        font-size: 0.9rem;
        color: #666;
        margin-bottom: 5px;
    }

    .product-price {
        color: #C6862B;
        font-weight: bold;
        font-size: 1rem;
        margin-bottom: 2px;
    }

    .product-stock {
        font-size: 0.85rem;
        color: #555;
        margin-bottom: 8px;
    }

    .btn-custom {
        background-color: #152A16;
        color: #fff;
        border: none;
        border-radius: 6px;
        padding: 6px 10px;
        font-size: 0.85rem;
        transition: 0.3s ease;
    }

        .btn-custom:hover {
            background-color: #0F1F10;
        }

    .btn-outline-heart {
        background-color: transparent;
        color: #C0392B;
        border: 1px solid #C0392B;
        font-size: 0.85rem;
        transition: 0.3s;
    }

        .btn-outline-heart:hover {
            background-color: #C0392B;
            color: #fff;
        }

    .action-buttons form {
        margin-bottom: 6px;
    }

    .alert {
        margin: 10px auto;
        max-width: 800px;
    }
</style>

@if (TempData["success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        @TempData["success"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}
@if (TempData["info"] != null)
{
    <div class="alert alert-info alert-dismissible fade show" role="alert">
        @TempData["info"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<h2>Danh sách sản phẩm</h2>

<div class="container">
    <div class="row row-cols-1 row-cols-sm-2 row-cols-md-3 row-cols-lg-4 g-4">
        @foreach (var product in Model)
        {
            <div class="col">
                <div class="product-card">
                    <img src="@Url.Content("~/" + product.ImageUrl)" class="card-img-top" alt="@product.ProductName" />
                    <div class="p-3">
                        <div class="product-title">@product.ProductName</div>
                        <div class="product-description">@product.Description</div>
                        <div class="product-price">@product.Price.ToString("N0") đ</div>
                        <div class="product-stock">Còn lại: @product.StockQuantity</div>

                        <div class="action-buttons mt-2">
                            <form asp-controller="Order" asp-action="BuyNow" method="post">
                                <input type="hidden" name="productId" value="@product.ProductId" />
                                <input type="hidden" name="quantity" value="1" />
                                <button type="submit" class="btn btn-custom w-100">
                                    ⚡ Mua ngay
                                </button>
                            </form>

                            <form asp-controller="Cart" asp-action="AddToCart" method="post">
                                <input type="hidden" name="productId" value="@product.ProductId" />
                                <input type="hidden" name="quantity" value="1" />
                                <button type="submit" class="btn btn-custom w-100">
                                    🛒 Thêm vào giỏ
                                </button>
                            </form>

                            <form asp-controller="Favorites" asp-action="AddFavorite" method="post">
                                <input type="hidden" name="productId" value="@product.ProductId" />
                                <button type="submit" class="btn btn-outline-heart w-100">
                                    ❤️ Yêu thích
                                </button>
                            </form>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
</div>
