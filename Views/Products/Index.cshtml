@model IEnumerable<test_2.Models.Product>

@{
    ViewData["Title"] = "Danh sách sản phẩm";
}

<section class="product-hero">
    <div class="container">
        <h2>@ViewData["Title"]</h2>
        <p class="product-hero-desc">Khám phá các sản phẩm chất lượng, giá tốt và ưu đãi hấp dẫn!</p>
    </div>
</section>

@if (TempData["success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        @TempData["success"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}
@if (TempData["info"] != null)
{
    <div class="alert alert-info alert-dismissible fade show" role="alert">
        @TempData["info"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/4.7.0/css/font-awesome.min.css" />

<section class="product-list-section">
    <div class="container">
        <div class="row justify-content-center g-4">
            @foreach (var product in Model)
            {
                <div class="col-12 col-sm-6 col-md-4 col-lg-3 d-flex align-items-stretch">
                    <div class="product-card w-100 h-100">
                        <a href="@Url.Action("Details", "Products", new { id = product.ProductId })" class="product-card-img-link">
                            <img src="@Url.Content("~/" + product.ImageUrl)" class="product-card-img" alt="@product.ProductName" />
                        </a>
                        <div class="product-card-body d-flex flex-column justify-content-between">
                            <div>
                                <h5 class="product-card-title" title="@product.ProductName">@product.ProductName</h5>
                                <div class="product-card-desc" title="@product.Description">
                                    @(product.Description != null && product.Description.Length > 60 ? product.Description.Substring(0, 60) + "..." : product.Description)
                                </div>
                                <div class="product-card-price">
                                    <span class="gradient-text">@product.Price.ToString("N0") đ</span>
                                </div>
                                <div class="product-card-stock">Còn lại: @product.StockQuantity</div>
                            </div>
                            <div class="mt-3">
                                <form asp-controller="Order" asp-action="BuyNow" method="post" class="mb-2">
                                    <input type="hidden" name="productId" value="@product.ProductId" />
                                    <input type="hidden" name="quantity" value="1" />
                                    <button type="submit" class="btn btn-buy-now w-100 mb-1">
                                        <i class="fa fa-bolt"></i> Mua ngay
                                    </button>
                                </form>
                                <form asp-controller="Cart" asp-action="AddToCart" method="post" class="mb-2">
                                    <input type="hidden" name="productId" value="@product.ProductId" />
                                    <input type="hidden" name="quantity" value="1" />
                                    <button type="submit" class="btn btn-add-cart w-100 mb-1">
                                        <i class="fa fa-shopping-cart"></i> Thêm vào giỏ
                                    </button>
                                </form>
                                <form asp-controller="Favorites" asp-action="AddFavorite" method="post">
                                    <input type="hidden" name="productId" value="@product.ProductId" />
                                    <button type="submit" class="btn btn-outline-danger w-100 btn-fav">
                                        <i class="fa fa-heart"></i> Yêu thích
                                    </button>
                                </form>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    </div>
</section>

<style>
    body { background: #f8f9fa; }
    .product-hero {
        background: linear-gradient(135deg, #28a745 0%, #20c997 50%, #17a2b8 100%);
        padding: 60px 0 30px 0;
        margin-top: 80px;
        color: white;
        text-align: center;
        border-radius: 0;
        box-shadow: 0 10px 30px rgba(40,167,69,0.08);
    }
    .product-hero h2 {
        font-size: 2.6rem;
        font-weight: 800;
        margin-bottom: 10px;
        text-shadow: 2px 2px 4px rgba(0,0,0,0.12);
    }
    .product-hero-desc {
        font-size: 1.1rem;
        opacity: 0.95;
        font-weight: 300;
        margin-bottom: 0;
    }
    .product-list-section {
        padding: 48px 0 72px 0;
        background: #f8f9fa;
    }
    .product-card {
        background: #fff;
        border-radius: 24px;
        box-shadow: 0 8px 32px rgba(40,167,69,0.10), 0 1.5px 8px rgba(32,32,32,0.04);
        padding: 0;
        margin-bottom: 0;
        transition: box-shadow 0.35s cubic-bezier(.4,2,.6,1), border 0.3s, transform 0.3s;
        border: 2px solid #e9ecef;
        overflow: hidden;
        display: flex;
        flex-direction: column;
        min-height: 100%;
        position: relative;
    }
    .product-card:hover {
        box-shadow: 0 16px 48px rgba(40,167,69,0.18), 0 4px 24px rgba(32,32,32,0.08);
        border: 2px solid;
        border-image: linear-gradient(135deg, #28a745 0%, #20c997 100%);
        border-image-slice: 1;
        z-index: 2;
    }
    .product-card-img-link {
        display: block;
        overflow: hidden;
        border-top-left-radius: 24px;
        border-top-right-radius: 24px;
    }
    .product-card-img {
        width: 100%;
        height: 200px;
        object-fit: cover;
        border-top-left-radius: 24px;
        border-top-right-radius: 24px;
        background: #e9ecef;
        transition: transform 0.4s cubic-bezier(.4,2,.6,1);
    }
    .product-card:hover .product-card-img {
        transform: scale(1.08) rotate(-1deg);
    }
    .product-card-body {
        padding: 28px 20px 20px 20px;
        flex: 1 1 auto;
        display: flex;
        flex-direction: column;
        justify-content: space-between;
    }
    .product-card-title {
        font-size: 1.25rem;
        font-weight: 800;
        color: #152A16;
        margin-bottom: 10px;
        letter-spacing: 0.5px;
        text-shadow: 1px 1px 2px rgba(40,167,69,0.06);
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
    }
    .product-card-desc {
        color: #6c757d;
        font-size: 1rem;
        margin-bottom: 14px;
        min-height: 40px;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
    }
    .product-card-price {
        font-weight: bold;
        font-size: 1.15rem;
        margin-bottom: 12px;
    }
    .gradient-text {
        background: linear-gradient(90deg, #C6862B 0%, #FFD700 100%);
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
        background-clip: text;
        text-fill-color: transparent;
        filter: drop-shadow(0 1px 2px #fffbe7);
    }
    .product-card-stock {
        color: #20c997;
        font-size: 0.98rem;
        font-weight: 600;
        margin-bottom: 2px;
    }
    .btn-buy-now {
        background: linear-gradient(135deg, #28a745 0%, #20c997 100%);
        color: #fff;
        border: none;
        border-radius: 12px;
        font-weight: 700;
        font-size: 1.08rem;
        letter-spacing: 0.5px;
        box-shadow: 0 4px 16px rgba(40,167,69,0.10);
        transition: all 0.3s;
    }
    .btn-buy-now:hover {
        background: linear-gradient(135deg, #20c997 0%, #28a745 100%);
        color: #fff;
        box-shadow: 0 10px 25px rgba(40,167,69,0.18);
        transform: translateY(-2px) scale(1.04);
    }
    .btn-add-cart {
        background: #fff;
        color: #28a745;
        border: 2px solid #28a745;
        border-radius: 12px;
        font-weight: 700;
        font-size: 1.08rem;
        letter-spacing: 0.5px;
        box-shadow: 0 2px 8px rgba(40,167,69,0.08);
        transition: all 0.3s;
    }
    .btn-add-cart:hover {
        background: #28a745;
        color: #fff;
        border-color: #20c997;
        box-shadow: 0 8px 18px rgba(40,167,69,0.18);
        transform: translateY(-2px) scale(1.04);
    }
    .btn-fav {
        border-radius: 12px;
        font-weight: 700;
        font-size: 1.08rem;
        letter-spacing: 0.5px;
        transition: all 0.3s;
    }
    .btn-fav:hover {
        background: #ffebee;
        color: #c62828;
        border-color: #c62828;
        transform: scale(1.06);
    }
    @@media (max-width: 991px) {
        .product-card-img { height: 160px; }
        .product-card-body { padding: 18px 10px 14px 10px; }
    }
    @@media (max-width: 767px) {
        .product-hero h2 { font-size: 2rem; }
        .product-card-body { padding: 12px 6px 10px 6px; }
        .product-card-img { height: 120px; }
    }
</style>
