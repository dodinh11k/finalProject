@model test_2.Models.Product

@{
    ViewData["Title"] = "Chi tiết sản phẩm";
}

<div class="container product-details-outer mt-5 mb-5">
    <div class="product-details-card row g-0 align-items-center">
        <div class="col-md-5 p-0">
            @if (!string.IsNullOrEmpty(Model.ImageUrl))
            {
                var imgSrc = Model.ImageUrl.StartsWith("/") ? Model.ImageUrl : "/" + Model.ImageUrl;
                <img src="@imgSrc" alt="@Model.ProductName" class="product-image-main" />
            }
            else
            {
                <img src="/images/no-image.png" alt="No image" class="product-image-main" />
            }
        </div>
        <div class="col-md-7 d-flex align-items-center">
            <div class="product-info-main w-100">
                <h2 class="product-title">@Model.ProductName</h2>
                <div class="product-detail-row">
                    <span class="product-detail-label">Giá:</span>
                    <span class="product-detail-value gradient-text">@Model.Price.ToString("N0") VNĐ</span>
                </div>
                <div class="product-detail-row">
                    <span class="product-detail-label">Mô tả:</span>
                    <span class="product-detail-value" title="@Model.Description">
                        @(Model.Description != null && Model.Description.Length > 80 ? Model.Description.Substring(0, 80) + "..." : Model.Description)
                    </span>
                </div>
                <div class="product-detail-row">
                    <span class="product-detail-label">Số lượng còn lại:</span>
                    <span class="product-detail-value">@Model.StockQuantity</span>
                </div>
                <div class="product-detail-row">
                    <span class="product-detail-label">Lượt mua:</span>
                    <span class="product-detail-value">@Model.PurchaseCount</span>
                </div>
                <div class="product-detail-row">
                    <span class="product-detail-label">Lượt đánh giá:</span>
                    <span class="product-detail-value">@ViewBag.ReviewCount</span>
                </div>
                <a href="@Url.Action("Index", "Products")" class="btn btn-back">← Quay lại danh sách</a>
            </div>
        </div>
    </div>
</div>

<style>
    body { background: #f8f9fa; }
    .product-details-outer {
        max-width: 950px;
    }
    .product-details-card {
        background: #fff;
        border-radius: 28px;
        box-shadow: 0 10px 32px rgba(40,167,69,0.10), 0 1.5px 8px rgba(32,32,32,0.04);
        overflow: hidden;
        margin: 0 auto;
        min-height: 340px;
        display: flex;
        flex-wrap: wrap;
    }
    .product-image-main {
        width: 100%;
        height: 100%;
        min-height: 320px;
        max-height: 420px;
        object-fit: cover;
        background: #e9ecef;
        display: block;
    }
    .product-info-main {
        padding: 40px 36px 32px 36px;
    }
    .product-title {
        color: #152A16;
        font-weight: 900;
        font-size: 2.1rem;
        margin-bottom: 28px;
        text-transform: uppercase;
        letter-spacing: 1px;
        text-align: left;
    }
    .product-detail-row {
        display: flex;
        align-items: flex-start;
        margin-bottom: 18px;
    }
    .product-detail-label {
        font-weight: 800;
        color: #222;
        min-width: 140px;
        font-size: 1.08rem;
        letter-spacing: 0.5px;
    }
    .product-detail-value {
        color: #222;
        font-size: 1.08rem;
        font-weight: 500;
        word-break: break-word;
    }
    .gradient-text {
        background: linear-gradient(90deg, #C6862B 0%, #FFD700 100%);
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
        background-clip: text;
        text-fill-color: transparent;
        filter: drop-shadow(0 1px 2px #fffbe7);
        font-weight: 700;
        font-size: 1.15rem;
    }
    .btn-back {
        background: linear-gradient(135deg, #28a745 0%, #20c997 100%);
        color: #fff;
        border: none;
        border-radius: 12px;
        font-weight: 700;
        font-size: 1.08rem;
        letter-spacing: 0.5px;
        box-shadow: 0 4px 16px rgba(40,167,69,0.10);
        transition: all 0.3s;
        padding: 12px 32px;
        margin-top: 24px;
        display: inline-block;
    }
    .btn-back:hover {
        background: linear-gradient(135deg, #20c997 0%, #28a745 100%);
        color: #fff;
        box-shadow: 0 10px 25px rgba(40,167,69,0.18);
        transform: translateY(-2px) scale(1.04);
    }
    @@media (max-width: 991px) {
        .product-details-card { flex-direction: column; }
        .product-info-main { padding: 18px 8px 12px 8px; }
        .product-title { font-size: 1.3rem; }
        .product-image-main { min-height: 180px; }
    }
    @@media (max-width: 767px) {
        .product-details-card { border-radius: 12px; }
        .product-info-main { padding: 10px 4px 8px 4px; }
        .product-title { font-size: 1.1rem; }
    }
</style> 