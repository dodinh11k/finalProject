@model test_2.Models.Product

@{
    ViewData["Title"] = "Chi tiết sản phẩm";
}

<style>
    .product-hero {
        background: linear-gradient(135deg, #28a745 0%, #20c997 50%, #17a2b8 100%);
        padding: 60px 0;
        margin-top: 80px;
        color: white;
        text-align: center;
        position: relative;
        overflow: hidden;
    }

    .product-hero::before {
        content: '';
        position: absolute;
        top: 0;
        left: 0;
        right: 0;
        bottom: 0;
        background: url('data:image/svg+xml,<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 100 100"><defs><pattern id="grain" width="100" height="100" patternUnits="userSpaceOnUse"><circle cx="50" cy="50" r="1" fill="white" opacity="0.1"/></pattern></defs><rect width="100" height="100" fill="url(%23grain)"/></svg>');
        opacity: 0.2;
    }

    .product-hero h1 {
        font-size: 2.8rem;
        font-weight: 800;
        margin-bottom: 15px;
        position: relative;
        z-index: 2;
        text-shadow: 2px 2px 4px rgba(0,0,0,0.3);
    }

    .product-hero p {
        font-size: 1.1rem;
        opacity: 0.95;
        position: relative;
        z-index: 2;
        font-weight: 300;
        max-width: 600px;
        margin: 0 auto;
    }

    .product-details-section {
        padding: 80px 0;
        background: #f8f9fa;
    }

    .product-details-container {
        max-width: 1200px;
        margin: 0 auto;
        padding: 0 20px;
    }

    .product-details-card {
        background: white;
        border-radius: 20px;
        box-shadow: 0 15px 40px rgba(0,0,0,0.1);
        overflow: hidden;
        position: relative;
    }

    .product-details-card::before {
        content: '';
        position: absolute;
        top: 0;
        left: 0;
        right: 0;
        height: 4px;
        background: linear-gradient(90deg, #28a745, #20c997);
    }

    .product-image-container {
        position: relative;
        overflow: hidden;
    }

    .product-image {
        width: 100%;
        height: 400px;
        object-fit: cover;
        transition: transform 0.3s ease;
    }

    .product-image:hover {
        transform: scale(1.05);
    }

    .product-info {
        padding: 40px;
        color: #2c3e50;
    }

    .product-title {
        font-size: 2.2rem;
        font-weight: 700;
        color: #2c3e50;
        margin-bottom: 30px;
        line-height: 1.2;
    }

    .product-price {
        font-size: 2rem;
        font-weight: 700;
        color: #28a745;
        margin-bottom: 25px;
        display: flex;
        align-items: center;
        gap: 10px;
    }

    .product-price::before {
        content: '💰';
        font-size: 1.5rem;
    }

    .product-description {
        font-size: 1.1rem;
        line-height: 1.7;
        color: #6c757d;
        margin-bottom: 30px;
        padding: 20px;
        background: #f8f9fa;
        border-radius: 12px;
        border-left: 4px solid #28a745;
    }

    .product-details-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
        gap: 20px;
        margin-bottom: 30px;
    }

    .detail-item {
        padding: 20px;
        background: linear-gradient(135deg, #f8f9fa 0%, #e9ecef 100%);
        border-radius: 12px;
        border-left: 4px solid #28a745;
    }

    .detail-label {
        font-size: 0.9rem;
        color: #6c757d;
        text-transform: uppercase;
        letter-spacing: 1px;
        font-weight: 600;
        margin-bottom: 8px;
    }

    .detail-value {
        font-size: 1.1rem;
        font-weight: 700;
        color: #2c3e50;
    }

    .product-actions {
        display: flex;
        gap: 15px;
        flex-wrap: wrap;
        margin-top: 30px;
    }

    .btn-back {
        background: linear-gradient(135deg, #6c757d 0%, #5a6268 100%);
        color: white;
        border: none;
        padding: 12px 25px;
        border-radius: 10px;
        font-weight: 600;
        text-decoration: none;
        transition: all 0.3s ease;
        display: inline-flex;
        align-items: center;
        gap: 8px;
    }

    .btn-back:hover {
        transform: translateY(-2px);
        box-shadow: 0 8px 20px rgba(108, 117, 125, 0.3);
        color: white;
    }

    .btn-buy-now {
        background: linear-gradient(135deg, #28a745 0%, #20c997 100%);
        color: white;
        border: none;
        padding: 12px 25px;
        border-radius: 10px;
        font-weight: 600;
        text-decoration: none;
        transition: all 0.3s ease;
        display: inline-flex;
        align-items: center;
        gap: 8px;
    }

    .btn-buy-now:hover {
        transform: translateY(-2px);
        box-shadow: 0 8px 20px rgba(40, 167, 69, 0.3);
        color: white;
    }

    .btn-add-cart {
        background: linear-gradient(135deg, #ffc107 0%, #e0a800 100%);
        color: #000;
        border: none;
        padding: 12px 25px;
        border-radius: 10px;
        font-weight: 600;
        text-decoration: none;
        transition: all 0.3s ease;
        display: inline-flex;
        align-items: center;
        gap: 8px;
    }

    .btn-add-cart:hover {
        transform: translateY(-2px);
        box-shadow: 0 8px 20px rgba(255, 193, 7, 0.3);
        color: #000;
    }

    .floating-shapes {
        position: absolute;
        width: 100%;
        height: 100%;
        overflow: hidden;
        z-index: 1;
    }

    .shape {
        position: absolute;
        background: rgba(255,255,255,0.1);
        border-radius: 50%;
        animation: float 6s ease-in-out infinite;
    }

    .shape:nth-child(1) {
        width: 60px;
        height: 60px;
        top: 20%;
        left: 10%;
        animation-delay: 0s;
    }

    .shape:nth-child(2) {
        width: 40px;
        height: 40px;
        top: 60%;
        right: 10%;
        animation-delay: 2s;
    }

    .shape:nth-child(3) {
        width: 30px;
        height: 30px;
        top: 40%;
        left: 50%;
        animation-delay: 4s;
    }

    @@keyframes float {
        0%, 100% { transform: translateY(0px) rotate(0deg); }
        50% { transform: translateY(-15px) rotate(180deg); }
    }

    .features-section {
        background: white;
        padding: 60px 0;
        margin-top: 40px;
    }

    .features-container {
        max-width: 1200px;
        margin: 0 auto;
        padding: 0 20px;
    }

    .features-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
        gap: 30px;
    }

    .feature-card {
        text-align: center;
        padding: 30px 20px;
        background: linear-gradient(135deg, #f8f9fa 0%, #e9ecef 100%);
        border-radius: 15px;
        box-shadow: 0 5px 15px rgba(0,0,0,0.1);
        transition: transform 0.3s ease;
    }

    .feature-card:hover {
        transform: translateY(-5px);
    }

    .feature-icon {
        font-size: 2.5rem;
        margin-bottom: 15px;
        color: #28a745;
    }

    .feature-title {
        font-size: 1.1rem;
        font-weight: 600;
        color: #2c3e50;
        margin-bottom: 10px;
    }

    .feature-desc {
        color: #6c757d;
        font-size: 0.9rem;
        line-height: 1.5;
    }

    .stock-status {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        padding: 8px 16px;
        border-radius: 20px;
        font-weight: 600;
        font-size: 0.9rem;
    }

    .stock-available {
        background: linear-gradient(135deg, #28a745 0%, #20c997 100%);
        color: white;
    }

    .stock-low {
        background: linear-gradient(135deg, #ffc107 0%, #e0a800 100%);
        color: #000;
    }

    .stock-out {
        background: linear-gradient(135deg, #dc3545 0%, #c82333 100%);
        color: white;
    }
</style>

<!-- Hero Section -->
<section class="product-hero">
    <div class="floating-shapes">
        <div class="shape"></div>
        <div class="shape"></div>
        <div class="shape"></div>
    </div>
    <div class="container">
        <h1>@Model.ProductName</h1>
        <p>Sản phẩm chất lượng cao với giá cả hợp lý</p>
    </div>
</section>

<!-- Product Details Section -->
<section class="product-details-section">
    <div class="product-details-container">
        <div class="product-details-card">
            <div class="row g-0">
                <div class="col-lg-6">
                    <div class="product-image-container">
                        @if (!string.IsNullOrEmpty(Model.ImageUrl))
                        {
                            var imgSrc = Model.ImageUrl.StartsWith("/") ? Model.ImageUrl : "/" + Model.ImageUrl;
                            <img src="@imgSrc" alt="@Model.ProductName" class="product-image" />
                        }
                        else
                        {
                            <img src="/images/no-image.png" alt="No image" class="product-image" />
                        }
                    </div>
                </div>
                <div class="col-lg-6">
                    <div class="product-info">
                        <h2 class="product-title">@Model.ProductName</h2>
                        
                        <div class="product-price">
                            @Model.Price.ToString("N0") VNĐ
                        </div>

                        @if (!string.IsNullOrEmpty(Model.Description))
                        {
                            <div class="product-description">
                                @Model.Description
                            </div>
                        }

                        <div class="product-details-grid">
                            <div class="detail-item">
                                <div class="detail-label">Số lượng</div>
                                <div class="detail-value">
                                    @if (Model.StockQuantity > 10)
                                    {
                                        <span class="stock-status stock-available">
                                            <i class="fa fa-check"></i>Còn hàng
                                        </span>
                                    }
                                    else if (Model.StockQuantity > 0)
                                    {
                                        <span class="stock-status stock-low">
                                            <i class="fa fa-exclamation-triangle"></i>Sắp hết
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="stock-status stock-out">
                                            <i class="fa fa-times"></i>Hết hàng
                                        </span>
                                    }
                                </div>
                            </div>
                            <div class="detail-item">
                                <div class="detail-label">Lượt mua</div>
                                <div class="detail-value">@Model.PurchaseCount</div>
                            </div>
                            <div class="detail-item">
                                <div class="detail-label">Đánh giá</div>
                                <div class="detail-value">⭐⭐⭐⭐⭐</div>
                            </div>
                            <div class="detail-item">
                                <div class="detail-label">Bảo hành</div>
                                <div class="detail-value">12 tháng</div>
                            </div>
                        </div>

                        <div class="product-actions">
                            <a class="btn-back" asp-controller="Products" asp-action="Index">
                                <i class="fa fa-arrow-left"></i>Quay lại
                            </a>
                            
                            @if (Model.StockQuantity > 0)
                            {
                                <form asp-controller="Order" asp-action="BuyNow" method="post" style="margin: 0;">
                                    <input type="hidden" name="productId" value="@Model.ProductId" />
                                    <input type="hidden" name="quantity" value="1" />
                                    <button type="submit" class="btn-buy-now">
                                        <i class="fa fa-bolt"></i>Mua ngay
                                    </button>
                                </form>
                                
                                <form asp-controller="Cart" asp-action="AddToCart" method="post" style="margin: 0;">
                                    <input type="hidden" name="productId" value="@Model.ProductId" />
                                    <input type="hidden" name="quantity" value="1" />
                                    <button type="submit" class="btn-add-cart">
                                        <i class="fa fa-shopping-cart"></i>Thêm vào giỏ
                                    </button>
                                </form>
                            }
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- Features Section -->
<section class="features-section">
    <div class="features-container">
        <div class="features-grid">
            <div class="feature-card">
                <div class="feature-icon">🚚</div>
                <div class="feature-title">Giao hàng miễn phí</div>
                <div class="feature-desc">Giao hàng miễn phí cho đơn hàng từ 500k trở lên</div>
            </div>
            <div class="feature-card">
                <div class="feature-icon">🛡️</div>
                <div class="feature-title">Bảo hành chính hãng</div>
                <div class="feature-desc">Sản phẩm chính hãng với chế độ bảo hành uy tín</div>
            </div>
            <div class="feature-card">
                <div class="feature-icon">💳</div>
                <div class="feature-title">Thanh toán an toàn</div>
                <div class="feature-desc">Hỗ trợ nhiều phương thức thanh toán bảo mật</div>
            </div>
            <div class="feature-card">
                <div class="feature-icon">🔄</div>
                <div class="feature-title">Đổi trả dễ dàng</div>
                <div class="feature-desc">Chính sách đổi trả trong 30 ngày nếu có lỗi</div>
            </div>
        </div>
    </div>
</section>

<!-- FontAwesome -->
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/4.7.0/css/font-awesome.min.css" /> 