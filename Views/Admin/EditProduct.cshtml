@{
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}
@model test_2.Models.Product
@{
    ViewBag.Title = "Sửa Sản phẩm";
}

<style>
    body {
        background-color: #1e1e1e;
        color: #fff;
    }

    .card {
        background-color: #2b2b2b;
        border: 1px solid #444;
    }

    .form-control, .form-select {
        background-color: #3a3a3a;
        color: #fff;
        border: 1px solid #555;
    }

        .form-control::placeholder {
            color: #aaa;
        }

    .form-label {
        color: #ccc;
    }

    .btn-success {
        background-color: #28a745;
        border: none;
    }

        .btn-success:hover {
            background-color: #218838;
        }

    .btn-secondary {
        background-color: #6c757d;
        border: none;
    }

        .btn-secondary:hover {
            background-color: #5a6268;
        }

    .text-danger {
        color: #ff6b6b !important;
    }

    h2 {
        font-weight: bold;
        color: #ffc107;
    }
</style>

<div class="d-flex justify-content-center align-items-center mt-7" style="min-height:80vh; margin-top: 100px !important;">
    <div class="card shadow p-4" style="max-width: 520px; width: 100%; border-radius: 16px;">
        <h2 class="text-center mb-4">Sửa Sản phẩm</h2>
        <form asp-action="EditProduct" method="post">
            @Html.AntiForgeryToken()
            <input type="hidden" asp-for="ProductId" />

            <div class="mb-3">
                <label asp-for="ProductName" class="form-label">Tên sản phẩm</label>
                <input asp-for="ProductName" class="form-control" />
                <span asp-validation-for="ProductName" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Description" class="form-label">Mô tả</label>
                <textarea asp-for="Description" class="form-control" rows="3" placeholder="Nhập mô tả chi tiết..."></textarea>
                <span asp-validation-for="Description" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Price" class="form-label">Giá (VNĐ)</label>
                <input asp-for="Price" type="number" step="0.01" class="form-control" />
                <span asp-validation-for="Price" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="StockQuantity" class="form-label">Số lượng</label>
                <input asp-for="StockQuantity" type="number" class="form-control" />
                <span asp-validation-for="StockQuantity" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="ImageUrl" class="form-label">Đường dẫn ảnh (URL)</label>
                <input asp-for="ImageUrl" class="form-control" />
                <span asp-validation-for="ImageUrl" class="text-danger"></span>
            </div>

            <div class="d-flex justify-content-between mt-4">
                <button type="submit" class="btn btn-success px-4">💾 Lưu</button>
                <a href="@Url.Action("Products")" class="btn btn-secondary px-4">← Quay lại</a>
            </div>
        </form>
    </div>
</div>
