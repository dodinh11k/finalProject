@model IEnumerable<test_2.Models.User>
@{
    ViewBag.Title = "Quản lý User/Staff/Tech";
}
<h2>Quản lý User/Staff/Tech</h2>
<form method="get">
    <label>Lọc theo vai trò:</label>
    <select name="role" onchange="this.form.submit()">
        <option value="">Tất cả</option>
        <option value="Admin">Admin</option>
        <option value="Staff">Staff</option>
        <option value="Technician">Technician</option>
        <option value="Customer">Customer</option>
    </select>
</form>
<a href="@Url.Action("CreateUser")" class="btn btn-success">Thêm User</a>
<table class="table">
    <thead>
        <tr>
            <th>ID</th><th>Tên đăng nhập</th><th>Họ tên</th><th>Email</th><th>Phone</th><th>Role</th><th>Active</th><th>Hành động</th>
        </tr>
    </thead>
    <tbody>
    @foreach(var u in Model) {
        <tr>
            <td>@u.UserId</td><td>@u.Username</td><td>@u.FullName</td><td>@u.Email</td><td>@u.Phone</td><td>@u.Role</td><td>@u.IsActive</td>
            <td>
                <a href="@Url.Action("EditUser", new { id = u.UserId })" class="btn btn-primary btn-sm">Sửa</a>
                <a href="@Url.Action("DeleteUser", new { id = u.UserId })" class="btn btn-danger btn-sm" onclick="return confirm('Xóa user này?');">Xóa</a>
            </td>
        </tr>
    }
    </tbody>
</table> 