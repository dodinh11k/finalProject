@{
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

@model IEnumerable<test_2.Models.Appointment>

@{
    ViewBag.Title = "Quản lý Đơn đặt lịch";
    var query = Context.Request.Query;
}

<style>
    body {
        background-color: #1e1e1e;
        color: #fff;
    }

    .table {
        background-color: #2b2b2b;
        color: #f1f1f1;
        border-radius: 8px;
        overflow: hidden;
        font-size: 14px;
    }

        .table thead {
            background-color: #343a40;
            color: #ffc107;
        }

        .table td, .table th {
            vertical-align: middle;
            padding: 12px 8px;
        }

    h2 {
        font-weight: bold;
        margin-top: 30px;
    }

    .btn-success {
        background-color: #28a745;
        border: none;
    }

        .btn-success:hover {
            background-color: #218838;
        }

    .btn-primary {
        background-color: #007bff;
        border: none;
    }

        .btn-primary:hover {
            background-color: #0069d9;
        }

    .btn-danger {
        background-color: #dc3545;
        border: none;
    }

        .btn-danger:hover {
            background-color: #c82333;
        }

    .btn-secondary {
        background-color: #6c757d;
        border: none;
    }

        .btn-secondary:hover {
            background-color: #5a6268;
        }

    /* Responsive table styles */
    .table-responsive {
        border-radius: 8px;
        box-shadow: 0 4px 6px rgba(0, 0, 0, 0.1);
    }

    /* Column widths for better layout */
    .table th:nth-child(1), .table td:nth-child(1) { width: 6%; }   /* ID */
    .table th:nth-child(2), .table td:nth-child(2) { width: 10%; }  /* SĐT */
    .table th:nth-child(3), .table td:nth-child(3) { width: 12%; }  /* Garage */
    .table th:nth-child(4), .table td:nth-child(4) { width: 15%; }  /* Địa chỉ Garage */
    .table th:nth-child(5), .table td:nth-child(5) { width: 12%; }  /* Kỹ thuật viên */
    .table th:nth-child(6), .table td:nth-child(6) { width: 10%; }  /* Thời gian */
    .table th:nth-child(7), .table td:nth-child(7) { width: 8%; }   /* Trạng thái */
    .table th:nth-child(8), .table td:nth-child(8) { width: 12%; }  /* Ghi chú */
    .table th:nth-child(9), .table td:nth-child(9) { width: 15%; }  /* Dịch vụ & Xe */
    .table th:nth-child(10), .table td:nth-child(10) { width: 10%; } /* Hành động */

    /* Text wrapping for long content columns */
    .table th:nth-child(4), .table td:nth-child(4),
    .table th:nth-child(8), .table td:nth-child(8),
    .table th:nth-child(9), .table td:nth-child(9) {
        white-space: normal;
        word-wrap: break-word;
        word-break: break-word;
        max-width: 200px;
        min-width: 120px;
    }

    /* Customer group header styling */
    .bg-light {
        background-color: #343a40 !important;
        color: #ffc107;
        border: 1px solid #555;
    }

    /* Mobile responsive */
    @@media (max-width: 768px) {
        .table {
            font-size: 12px;
        }
        
        .table td, .table th {
            padding: 8px 4px;
        }
        
        .table th:nth-child(4), .table td:nth-child(4),
        .table th:nth-child(8), .table td:nth-child(8),
        .table th:nth-child(9), .table td:nth-child(9) {
            max-width: 120px;
        }
        
        .btn-sm {
            padding: 4px 8px;
            font-size: 11px;
        }
        
        .row {
            margin: 0;
        }
        
        .col-md-2, .col-md-3 {
            margin-bottom: 10px;
        }
        
        .form-control {
            font-size: 12px;
        }
    }

    /* Tablet responsive */
    @@media (min-width: 769px) and (max-width: 1024px) {
        .table {
            font-size: 13px;
        }
        
        .table td, .table th {
            padding: 10px 6px;
        }
        
        .table th:nth-child(4), .table td:nth-child(4),
        .table th:nth-child(8), .table td:nth-child(8),
        .table th:nth-child(9), .table td:nth-child(9) {
            max-width: 180px;
        }
    }

    /* Large screen optimization */
    @@media (min-width: 1025px) {
        .table-responsive {
            max-width: 100%;
            margin: 0 auto;
        }
        
        .table th:nth-child(4), .table td:nth-child(4),
        .table th:nth-child(8), .table td:nth-child(8),
        .table th:nth-child(9), .table td:nth-child(9) {
            max-width: 250px;
        }
    }

    /* Hover effects */
    .table tbody tr:hover {
        background-color: #3a3a3a;
        transition: background-color 0.2s ease;
    }

    /* Service details styling */
    .table ul {
        margin: 0;
        padding-left: 15px;
    }

    .table li {
        margin-bottom: 5px;
        font-size: 12px;
    }

    .table strong {
        color: #ffc107;
    }
</style>

<h2 class="text-center">@ViewBag.Title</h2>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success">@TempData["SuccessMessage"]</div>
}

<div class="d-flex justify-content-between align-items-center my-4">
    <a href="@Url.Action("Dashboard", "Admin")" class="btn btn-secondary">← Trang chính Admin</a>
</div>

<form asp-action="Orders" method="get" class="mb-4">
    <div class="row">
        <div class="col-md-3">
            <input name="customerName" class="form-control" placeholder="Tên khách hàng" value="@query["customerName"]" />
        </div>
        <div class="col-md-2">
            <input name="phone" class="form-control" placeholder="SĐT" value="@query["phone"]" />
        </div>
        <div class="col-md-2">
            <input type="date" name="date" class="form-control" value="@query["date"]" />
        </div>
        <div class="col-md-3">
            <input name="vehicleKeyword" class="form-control" placeholder="Hãng, Model hoặc Biển số xe" value="@query["vehicleKeyword"]" />
        </div>
        <div class="col-md-2">
            <button type="submit" class="btn btn-primary w-100">Tìm kiếm</button>
        </div>
    </div>
</form>

@if (!Model.Any())
{
    <div class="alert alert-warning">Không có lịch hẹn nào khớp với tìm kiếm.</div>
}
else
{
    @foreach (var group in Model.GroupBy(x => x.User?.FullName ?? "Không rõ"))
    {
        <div class="bg-light p-2 mb-2 rounded border">
            <h5>Khách hàng: @group.Key</h5>
        </div>

        <div class="table-responsive">
            <table class="table table-bordered table-hover align-middle mb-5">
                <thead>
                    <tr>
                        <th>ID</th>
                        <th>SĐT</th>
                        <th>Garage</th>
                        <th>Địa chỉ Garage</th>
                        <th>Kỹ thuật viên</th>
                        <th>Thời gian</th>
                        <th>Trạng thái</th>
                        <th>Ghi chú</th>
                        <th>Dịch vụ & Xe</th>
                        <th>Hành động</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var o in group)
                    {
                        <tr>
                            <td>@o.AppointmentId</td>
                            <td>@o.User?.Phone</td>
                            <td>@o.Garage?.Name</td>
                            <td>@o.Garage?.Address</td>
                            <td>
                                @{
                                    var technician = o.AppointmentVehicleDetails?.FirstOrDefault()?.Technician;
                                }
                                @(technician?.FullName ?? "Chưa gán")
                            </td>
                            <td>@(o.AppointmentTime?.ToString("dd/MM/yyyy HH:mm"))</td>
                            <td>@o.Status</td>
                            <td>@o.Notes</td>
                            <td>
                                @if (o.AppointmentVehicleDetails != null && o.AppointmentVehicleDetails.Any())
                                {
                                    <ul>
                                        @foreach (var detail in o.AppointmentVehicleDetails)
                                        {
                                            <li>
                                                <strong>Xe:</strong> @detail.Vehicle?.Make @detail.Vehicle?.Model (@detail.Vehicle?.LicensePlate)<br />
                                                <strong>Dịch vụ:</strong> @detail.Service?.ServiceName<br />
                                                <strong>Số lượng:</strong> @detail.Quantity<br />
                                                @if (!string.IsNullOrWhiteSpace(detail.Note))
                                                {
                                                    <strong>Ghi chú:</strong> @detail.Note
                                                }
                                            </li>
                                        }
                                    </ul>
                                }
                            </td>
                            <td>
                                <a href="@Url.Action("EditOrder", new { id = o.AppointmentId })" class="btn btn-primary btn-sm">Sửa</a>
                                <a href="@Url.Action("DeleteOrder", new { id = o.AppointmentId })" class="btn btn-danger btn-sm"
                                   onclick="return confirm('Xác nhận xóa lịch hẹn này?');">Xóa</a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
}
