@model test_2.Models.User

@{
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<style>
    body {
        background-color: #1e1e1e;
        color: #fff;
    }

    .card {
        background-color: #2c2c2c;
        color: #fff;
        border: none;
        border-radius: 16px;
    }

    .form-control, .form-select {
        background-color: #3a3a3a;
        border: 1px solid #555;
        color: #f1f1f1;
    }

        .form-control:focus, .form-select:focus {
            background-color: #444;
            color: #fff;
            box-shadow: 0 0 0 0.2rem rgba(255, 193, 7, 0.25);
        }

    label {
        font-weight: 500;
        color: #f0f0f0;
    }

    .btn-success {
        background-color: #28a745;
        border: none;
    }

        .btn-success:hover {
            background-color: #218838;
        }

    .btn-secondary {
        background-color: #6c757d;
        border: none;
    }

        .btn-secondary:hover {
            background-color: #5a6268;
        }

    .text-danger {
        font-size: 0.875rem;
    }
</style>

<div class="d-flex justify-content-center align-items-center" style="min-height:90vh;">
    <div class="card shadow p-4" style="max-width: 550px; width: 100%;">
        <h2 class="text-center mb-4" style="font-weight:bold;">Sửa User / Staff / Tech</h2>
        <form asp-action="EditUser" method="post">
            @Html.AntiForgeryToken()
            <input type="hidden" asp-for="UserId" />

            <div asp-validation-summary="All" class="text-danger mb-2"></div>

            <div class="mb-3">
                <label asp-for="Username" class="form-label">Tên đăng nhập</label>
                <input asp-for="Username" class="form-control" />
                <span asp-validation-for="Username" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label class="form-label">Mật khẩu (để trống nếu không đổi)</label>
                <input asp-for="PasswordHash" class="form-control" type="password" />
                <span asp-validation-for="PasswordHash" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="FullName" class="form-label">Họ tên</label>
                <input asp-for="FullName" class="form-control" />
                <span asp-validation-for="FullName" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Email" class="form-label">Email</label>
                <input asp-for="Email" class="form-control" />
                <span asp-validation-for="Email" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Phone" class="form-label">Số điện thoại</label>
                <input asp-for="Phone" class="form-control" />
                <span asp-validation-for="Phone" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Address" class="form-label">Địa chỉ</label>
                <input asp-for="Address" class="form-control" />
                <span asp-validation-for="Address" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Role" class="form-label">Vai trò</label>
                <select asp-for="Role" class="form-select">
                    <option value="Admin">Admin</option>
                    <option value="Staff">Staff</option>
                    <option value="Technician">Technician</option>
                    <option value="User">User</option>
                </select>
                <span asp-validation-for="Role" class="text-danger"></span>
            </div>

            <div class="form-check mb-3">
                <input asp-for="IsActive" class="form-check-input" id="isActiveCheck" />
                <label class="form-check-label" for="isActiveCheck">Kích hoạt</label>
            </div>

            <div class="d-flex justify-content-between mt-3">
                <button type="submit" class="btn btn-success px-4">💾 Lưu</button>
                <a href="@Url.Action("Users")" class="btn btn-secondary px-4">← Quay lại</a>
            </div>
        </form>
    </div>
</div>
