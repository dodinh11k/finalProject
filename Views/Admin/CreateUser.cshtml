@model test_2.Models.User

<div class="d-flex justify-content-center align-items-center mt-7" style="min-height:80vh; margin-top: 100px !important;">
    <div class="card shadow p-4" style="max-width: 500px; width: 100%; border-radius: 16px;">
        <h2 class="text-center mb-4" style="font-weight:bold;">Tạo User Mới</h2>
        <form asp-action="CreateUser" method="post" autocomplete="off">
            @Html.AntiForgeryToken()

            <div class="mb-3">
                <label asp-for="Username" class="form-label">Tên đăng nhập</label>
                <input asp-for="Username" class="form-control" autocomplete="off" />
                <span asp-validation-for="Username" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="PasswordHash" class="form-label">Mật khẩu</label>
                <input asp-for="PasswordHash" class="form-control" type="password" autocomplete="new-password" />
                <span asp-validation-for="PasswordHash" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="FullName" class="form-label">Họ tên</label>
                <input asp-for="FullName" class="form-control" />
                <span asp-validation-for="FullName" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Email" class="form-label">Email</label>
                <input asp-for="Email" class="form-control" />
                <span asp-validation-for="Email" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Phone" class="form-label">Số điện thoại</label>
                <input asp-for="Phone" class="form-control" />
                <span asp-validation-for="Phone" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Address" class="form-label">Địa chỉ</label>
                <input asp-for="Address" class="form-control" />
                <span asp-validation-for="Address" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Role" class="form-label">Vai trò</label>
                <select asp-for="Role" class="form-select">
                    <option value="Admin">Admin</option>
                    <option value="Staff">Staff</option>
                    <option value="Technician">Technician</option>
                    <option value="Customer">Customer</option>
                </select>
                <span asp-validation-for="Role" class="text-danger"></span>
            </div>

            <div class="form-check mb-3">
                <input asp-for="IsActive" class="form-check-input" id="isActiveCheck" />
                <label asp-for="IsActive" class="form-check-label" for="isActiveCheck">Active</label>
            </div>

            <div class="d-flex justify-content-between">
                <button type="submit" class="btn btn-success px-4">Lưu</button>
                <a asp-action="Users" class="btn btn-secondary px-4">Quay lại</a>
            </div>
        </form>
    </div>
</div>
