@model IEnumerable<test_2.Models.Service>

@{
    ViewData["Title"] = "Danh sách dịch vụ";
}

<style>
    .services-container {
        display: flex;
        flex-wrap: wrap;
        gap: 20px;
        justify-content: flex-start;
        padding: 20px;
    }

    .service-card {
        width: 280px;
        border: 1px solid #ddd;
        border-radius: 12px;
        overflow: hidden;
        box-shadow: 0 2px 8px rgba(0,0,0,0.1);
        transition: transform 0.3s;
        background-color: #fff;
    }

        .service-card:hover {
            transform: translateY(-5px);
        }

        .service-card img {
            width: 100%;
            height: 180px;
            object-fit: cover;
        }

    .service-card-body {
        padding: 15px;
    }

    .service-card-title {
        font-size: 20px;
        margin-bottom: 8px;
        color: #2c3e50;
    }

    .service-card-garage {
        font-size: 16px;
        color: #7f8c8d;
    }

    .no-services {
        padding: 20px;
        font-size: 18px;
        color: #888;
    }
</style>

<h2 style="margin-left: 20px;">Danh sách dịch vụ</h2>

@if (Model == null || !Model.Any())
{
    <p class="no-services">Không có dịch vụ nào.</p>
}
else
{
    @* <!-- Đoạn debug hiển thị ImageUrl từng service --> *@
    @* <div style="margin: 20px;"> *@
    @*     <h3>Debug ImageUrl của các dịch vụ:</h3> *@
    @*     @foreach (var s in Model) *@
    @*     { *@
    @*         <p>@s.ServiceName - ImageUrl: '@(s.image_url ?? "NULL")'</p> *@
    @*     } *@
    @* </div> *@

    <div class="services-container">
        @foreach (var service in Model)
        {
            <div class="service-card">

                <img src="@(
                    !string.IsNullOrEmpty(service.image_url)
                    ? Url.Content("~/" + service.image_url.TrimStart('/'))
                    : Url.Content("~/images/default-image.png")
                )" alt="@service.ServiceName" />

                <div class="service-card-body">
                    <div class="service-card-title">@service.ServiceName</div>
                    <div class="service-card-garage">Garage: @service.Garage?.Name</div>
                    <div style="margin-top: 10px; font-size: 14px; color: #bbb;">Mã dịch vụ: @service.ServiceId</div>
                </div>
            </div>
        }
    </div>
}
